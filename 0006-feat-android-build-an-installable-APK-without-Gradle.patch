diff --git a/android/wailsshim/process.go b/android/wailsshim/process.go
new file mode 100644
index 00000000..e6d933d3
--- /dev/null
+++ b/android/wailsshim/process.go
@@ -0,0 +1,149 @@
+package wails
+
+// Process mode: the core as a child process of the Android app.
+//
+// The JNI build needs the Android NDK. Process mode does not: Go builds a pure
+// executable for android/arm64 without cgo, the app ships it as a native
+// library (so Android installs it executable) and starts it, and the bridge
+// runs over a loopback HTTP connection instead of JNI. The Java side
+// (GoBridge.java, process flavour) offers the same calls either way, so the
+// WebView, the shim and everything above them are identical.
+//
+// Protocol (every request carries X-STR-Token; anything else gets 403):
+//
+//	POST /call        {"method": "...", "args": [...]}  -> envelope JSON
+//	GET  /next?ms=N   next event or host request, 204 when none in N ms
+//	POST /hostreply?id=N   body: the host's answer
+//	POST /emit?name=X      body: JSON array, for Go-side EventsOn listeners
+//	POST /beforeclose      "1" when leaving should be refused, else "0"
+//
+// Lifetime: the parent holds the write end of our stdin. When the app process
+// dies, for whatever reason, stdin reaches EOF and the core exits with it, so
+// no orphan keeps polling speakers.
+
+import (
+	"context"
+	"crypto/subtle"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"log"
+	"net"
+	"net/http"
+	"os"
+	"strconv"
+	"time"
+
+	"github.com/wailsapp/wails/v2/pkg/mobile"
+	"github.com/wailsapp/wails/v2/pkg/options"
+)
+
+const maxBody = 32 << 20 // a backup or a station list, never more
+
+func runProcessMode(o *options.App) error {
+	token := os.Getenv("STR_BRIDGE_TOKEN")
+	if len(token) < 32 {
+		return errors.New("process mode needs STR_BRIDGE_TOKEN (at least 32 characters) from the Android host")
+	}
+	addr := os.Getenv("STR_BRIDGE_ADDR")
+	if addr == "" {
+		addr = "127.0.0.1:0"
+	}
+	host, _, err := net.SplitHostPort(addr)
+	if err != nil || (host != "127.0.0.1" && host != "::1" && host != "localhost") {
+		return fmt.Errorf("process mode only listens on loopback, not %q", addr)
+	}
+	if d := os.Getenv("XDG_CACHE_HOME"); d != "" {
+		mobile.SetCacheDir(d)
+	}
+	log.SetFlags(0)
+	log.SetOutput(os.Stderr)
+
+	go func() {
+		_, _ = io.Copy(io.Discard, os.Stdin)
+		log.Print("STR core: host went away, exiting")
+		os.Exit(0)
+	}()
+
+	for _, b := range o.Bind {
+		mobile.Bind(b)
+	}
+	ctx := context.Background()
+
+	auth := func(h http.HandlerFunc) http.HandlerFunc {
+		return func(w http.ResponseWriter, r *http.Request) {
+			if subtle.ConstantTimeCompare([]byte(r.Header.Get("X-STR-Token")), []byte(token)) != 1 {
+				http.Error(w, "forbidden", http.StatusForbidden)
+				return
+			}
+			r.Body = http.MaxBytesReader(w, r.Body, maxBody)
+			h(w, r)
+		}
+	}
+
+	mux := http.NewServeMux()
+	mux.HandleFunc("/call", auth(func(w http.ResponseWriter, r *http.Request) {
+		var req struct {
+			Method string          `json:"method"`
+			Args   json.RawMessage `json:"args"`
+		}
+		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write(mobile.Call(req.Method, string(req.Args)))
+	}))
+	mux.HandleFunc("/next", auth(func(w http.ResponseWriter, r *http.Request) {
+		ms, _ := strconv.Atoi(r.URL.Query().Get("ms"))
+		if ms <= 0 || ms > 30000 {
+			ms = 1000
+		}
+		b := mobile.NextEvent(time.Duration(ms) * time.Millisecond)
+		if b == nil {
+			w.WriteHeader(http.StatusNoContent)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write(b)
+	}))
+	mux.HandleFunc("/hostreply", auth(func(w http.ResponseWriter, r *http.Request) {
+		id, err := strconv.ParseInt(r.URL.Query().Get("id"), 10, 64)
+		if err != nil {
+			http.Error(w, "bad id", http.StatusBadRequest)
+			return
+		}
+		b, _ := io.ReadAll(r.Body)
+		mobile.HostReply(id, b)
+	}))
+	mux.HandleFunc("/emit", auth(func(w http.ResponseWriter, r *http.Request) {
+		b, _ := io.ReadAll(r.Body)
+		mobile.Dispatch(r.URL.Query().Get("name"), string(b))
+	}))
+	mux.HandleFunc("/beforeclose", auth(func(w http.ResponseWriter, r *http.Request) {
+		prevent := o.OnBeforeClose != nil && o.OnBeforeClose(ctx)
+		if prevent {
+			_, _ = io.WriteString(w, "1")
+		} else {
+			_, _ = io.WriteString(w, "0")
+		}
+	}))
+
+	ln, err := net.Listen("tcp", addr)
+	if err != nil {
+		return err
+	}
+	// The host reads this line from our stdout to learn the port.
+	fmt.Printf("STR_BRIDGE_LISTENING %s\n", ln.Addr())
+	srv := &http.Server{Handler: mux, ReadHeaderTimeout: 10 * time.Second}
+	errCh := make(chan error, 1)
+	go func() { errCh <- srv.Serve(ln) }()
+
+	// Bound calls may arrive before startup finishes; the desktop app is
+	// written for that (App.appCtx), as Wails dispatches the same way.
+	if o.OnStartup != nil {
+		o.OnStartup(ctx)
+	}
+	return <-errCh
+}

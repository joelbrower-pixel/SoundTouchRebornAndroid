+++ b/android/app/src/main/java/de/streborn/android/Core.java
@@ -0,0 +1,89 @@
+package de.streborn.android;
+
+import android.content.Context;
+import android.util.Log;
+
+import java.io.File;
+import java.util.Map;
+
+/**
+ * The Go core, whichever way it was built.
+ *
+ * <ul>
+ *   <li><b>JNI</b>: {@code libstr.so}, the desktop app built with
+ *       {@code -buildmode=c-shared} (needs the NDK; the Gradle build).
+ *   <li><b>Process</b>: {@code libstrcore.so}, the desktop app built as a plain
+ *       android/arm64 executable without cgo (no NDK; android/build-apk.sh),
+ *       run as a child process and reached over a private loopback port.
+ * </ul>
+ *
+ * <p>Both offer the same operations, so nothing above this class knows which
+ * one is running.
+ */
+final class Core {
+    private static final String TAG = "STR";
+    private static volatile boolean jni;
+    private static volatile boolean started;
+    // Process mode cannot ask the core whether an update is running, but every
+    // SetOTARunning call passes through here, so it is tracked on the way.
+    private static volatile boolean otaRunning;
+
+    private Core() {}
+
+    static synchronized void start(Context ctx, String configJson, Map<String, String> env) {
+        if (started) return;
+        File exe = new File(ctx.getApplicationInfo().nativeLibraryDir, "libstrcore.so");
+        if (exe.exists()) {
+            ProcessCore.start(exe, env);
+        } else {
+            System.loadLibrary("str");
+            jni = true;
+            new Thread(new Runnable() { @Override public void run() { GoBridge.start(GoBridge.utf8(configJson)); } }, "str-start").start();
+        }
+        started = true;
+        Log.i(TAG, "core started (" + (jni ? "JNI" : "process") + ")");
+    }
+
+    static String call(String method, String argsJson) {
+        if ("SetOTARunning".equals(method) && argsJson != null) {
+            otaRunning = argsJson.contains("true");
+        }
+        if (jni) return GoBridge.str(GoBridge.call(GoBridge.utf8(method), GoBridge.utf8(argsJson)));
+        return ProcessCore.call(method, argsJson);
+    }
+
+    /** Next event or host request as JSON, or null after the timeout. */
+    static String nextEvent(int timeoutMs) {
+        if (jni) return GoBridge.str(GoBridge.nextEvent(timeoutMs));
+        return ProcessCore.nextEvent(timeoutMs);
+    }
+
+    static void hostReply(long id, String payloadJson) {
+        if (jni) {
+            GoBridge.hostReply(id, GoBridge.utf8(payloadJson));
+        } else {
+            ProcessCore.hostReply(id, payloadJson);
+        }
+    }
+
+    static void emit(String name, String dataJson) {
+        if (jni) {
+            GoBridge.emit(GoBridge.utf8(name), GoBridge.utf8(dataJson));
+        } else {
+            ProcessCore.emit(name, dataJson);
+        }
+    }
+
+    /** True when leaving now should be refused (an update is running and the user chose to stay). */
+    static boolean beforeClose() {
+        if (jni) return GoBridge.beforeClose();
+        return ProcessCore.beforeClose();
+    }
+
+    /** True while an install or update runs. */
+    static boolean busy() {
+        if (!started) return false;
+        if (jni) return GoBridge.busy();
+        return otaRunning;
+    }
+}

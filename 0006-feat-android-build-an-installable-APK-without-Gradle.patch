diff --git a/android/app/src/main/java/de/streborn/android/ProcessCore.java b/android/app/src/main/java/de/streborn/android/ProcessCore.java
new file mode 100644
index 00000000..16bfa581
--- /dev/null
+++ b/android/app/src/main/java/de/streborn/android/ProcessCore.java
@@ -0,0 +1,206 @@
+package de.streborn.android;
+
+import android.util.Log;
+
+import org.json.JSONObject;
+
+import java.io.BufferedReader;
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.Proxy;
+import java.net.URL;
+import java.net.URLEncoder;
+import java.nio.charset.StandardCharsets;
+import java.security.SecureRandom;
+import java.util.Map;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * The Go core as a child process (android/wailsshim/process.go has the other
+ * half of the protocol).
+ *
+ * <p>The core listens on a loopback port it picks itself and announces it on
+ * stdout. Every request carries a random per-launch token, so other apps on
+ * the device, which can reach loopback ports too, cannot drive it. The
+ * process's stdin stays open for as long as this app process lives; the core
+ * exits when it reaches EOF, so it never outlives the app.
+ */
+final class ProcessCore {
+    private static final String TAG = "STR";
+
+    private static final CountDownLatch ready = new CountDownLatch(1);
+    private static volatile String base; // http://127.0.0.1:PORT
+    private static volatile String token;
+    private static Process process;
+    @SuppressWarnings("unused") // held only so the pipe stays open
+    private static OutputStream lifeline;
+
+    private ProcessCore() {}
+
+    static void start(File exe, Map<String, String> env) {
+        byte[] t = new byte[24];
+        new SecureRandom().nextBytes(t);
+        StringBuilder sb = new StringBuilder();
+        for (byte b : t) sb.append(String.format("%02x", b));
+        token = sb.toString();
+
+        ProcessBuilder pb = new ProcessBuilder(exe.getAbsolutePath());
+        pb.environment().putAll(env);
+        pb.environment().put("STR_BRIDGE_TOKEN", token);
+        pb.environment().put("STR_BRIDGE_ADDR", "127.0.0.1:0");
+        pb.redirectErrorStream(true);
+        try {
+            process = pb.start();
+        } catch (IOException e) {
+            Log.e(TAG, "could not start the core", e);
+            return;
+        }
+        lifeline = process.getOutputStream();
+        final InputStream out = process.getInputStream();
+        Thread reader = new Thread(new Runnable() { @Override public void run() {
+            try (BufferedReader r = new BufferedReader(new InputStreamReader(out, StandardCharsets.UTF_8))) {
+                String line;
+                while ((line = r.readLine()) != null) {
+                    if (base == null && line.startsWith("STR_BRIDGE_LISTENING ")) {
+                        base = "http://" + line.substring("STR_BRIDGE_LISTENING ".length()).trim();
+                        ready.countDown();
+                        Log.i(TAG, "core listening on " + base);
+                    } else {
+                        Log.i(TAG, "core: " + line);
+                    }
+                }
+            } catch (IOException ignored) {
+                // process ended
+            }
+            Log.w(TAG, "core process ended");
+        } }, "str-core-log");
+        reader.setDaemon(true);
+        reader.start();
+    }
+
+    private static boolean awaitReady() {
+        try {
+            return ready.await(30, TimeUnit.SECONDS) && base != null;
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            return false;
+        }
+    }
+
+    static String call(String method, String argsJson) {
+        if (!awaitReady()) return error("the app core did not start");
+        String args = argsJson == null || argsJson.trim().isEmpty() ? "[]" : argsJson;
+        String body = "{\"method\":" + JSONObject.quote(method) + ",\"args\":" + args + "}";
+        try {
+            Response r = request("POST", "/call", body, 0);
+            if (r.code == 200) return r.body;
+            return error("app core answered " + r.code + ": " + r.body);
+        } catch (IOException e) {
+            return error("app core unreachable: " + e.getMessage());
+        }
+    }
+
+    static String nextEvent(int timeoutMs) {
+        if (!awaitReady()) return null;
+        try {
+            Response r = request("GET", "/next?ms=" + timeoutMs, null, timeoutMs + 15000);
+            return r.code == 200 ? r.body : null;
+        } catch (IOException e) {
+            sleepQuietly(500); // core restarting or gone; do not spin
+            return null;
+        }
+    }
+
+    static void hostReply(long id, String payload) {
+        if (!awaitReady()) return;
+        try {
+            request("POST", "/hostreply?id=" + id, payload, 15000);
+        } catch (IOException e) {
+            Log.w(TAG, "hostReply", e);
+        }
+    }
+
+    static void emit(String name, String dataJson) {
+        if (!awaitReady()) return;
+        try {
+            request("POST", "/emit?name=" + URLEncoder.encode(name, "UTF-8"), dataJson, 15000);
+        } catch (IOException e) {
+            Log.w(TAG, "emit", e);
+        }
+    }
+
+    static boolean beforeClose() {
+        if (!awaitReady()) return false;
+        try {
+            // May show a dialog and wait for the user; no read timeout.
+            return "1".equals(request("POST", "/beforeclose", "", 0).body.trim());
+        } catch (IOException e) {
+            return false;
+        }
+    }
+
+    // ---- HTTP -----------------------------------------------------------------------
+
+    private static final class Response {
+        final int code;
+        final String body;
+
+        Response(int code, String body) {
+            this.code = code;
+            this.body = body;
+        }
+    }
+
+    private static Response request(String method, String path, String body, int readTimeoutMs) throws IOException {
+        HttpURLConnection c = (HttpURLConnection) new URL(base + path).openConnection(Proxy.NO_PROXY);
+        try {
+            c.setRequestMethod(method);
+            c.setConnectTimeout(5000);
+            c.setReadTimeout(readTimeoutMs);
+            c.setUseCaches(false);
+            c.setRequestProperty("X-STR-Token", token);
+            if (body != null) {
+                byte[] b = body.getBytes(StandardCharsets.UTF_8);
+                c.setDoOutput(true);
+                c.setFixedLengthStreamingMode(b.length);
+                c.setRequestProperty("Content-Type", "application/json; charset=utf-8");
+                try (OutputStream os = c.getOutputStream()) {
+                    os.write(b);
+                }
+            }
+            int code = c.getResponseCode();
+            InputStream in = code >= 400 ? c.getErrorStream() : (code == 204 ? null : c.getInputStream());
+            return new Response(code, in == null ? "" : readAll(in));
+        } finally {
+            c.disconnect();
+        }
+    }
+
+    private static String readAll(InputStream in) throws IOException {
+        try (InputStream i = in) {
+            ByteArrayOutputStream bo = new ByteArrayOutputStream();
+            byte[] buf = new byte[16384];
+            int n;
+            while ((n = i.read(buf)) > 0) bo.write(buf, 0, n);
+            return new String(bo.toByteArray(), StandardCharsets.UTF_8);
+        }
+    }
+
+    private static String error(String msg) {
+        return "{\"ok\":false,\"error\":" + JSONObject.quote(msg) + "}";
+    }
+
+    private static void sleepQuietly(long ms) {
+        try {
+            Thread.sleep(ms);
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+        }
+    }
+}
diff --git a/android/build-apk.sh b/android/build-apk.sh
new file mode 100755
index 00000000..e22f5108
--- /dev/null
+++ b/android/build-apk.sh
@@ -0,0 +1,207 @@
+#!/usr/bin/env bash
+# Build an installable ST Reborn APK without Gradle, Maven or the NDK.
+#
+#   android/build-apk.sh
+#
+# This is the "process mode" build (android/wailsshim/process.go): the Go core
+# is a plain android/arm64 executable, which Go builds without cgo, so no NDK is
+# needed; and the app has no dependencies beyond the platform, so the APK can be
+# put together with the SDK's own command-line tools instead of Gradle. Use it
+# where Google's Maven and SDK servers are out of reach. android/build.sh (the
+# JNI build through Gradle) is the regular route.
+#
+# Needs: Go, Node/npm, a JDK (javac, keytool), and the Android build tools
+# aapt, dx (dalvik-exchange), zipalign and apksigner. On Debian or Ubuntu:
+#   apt install aapt dalvik-exchange zipalign apksigner
+# plus an android.jar for the platform (ANDROID_JAR; the default downloads the
+# API 35 one from github.com/Sable/android-platforms).
+#
+# Signing: STR_KEYSTORE / STR_KEYSTORE_PASSWORD / STR_KEY_ALIAS /
+# STR_KEY_PASSWORD, as for build.sh. Without them a local key is created under
+# ~/.android/str-local.keystore and reused, so later builds install as updates.
+set -euo pipefail
+
+HERE="$(cd "$(dirname "$0")" && pwd)"
+ROOT="$(cd "$HERE/.." && pwd)"
+APPDIR="$ROOT/desktop-app"
+SRC="$HERE/app/src/main"
+GO="${GO:-go}"
+
+VERSION="${VERSION:-$(git -C "$ROOT" describe --tags --always --dirty 2>/dev/null || echo dev)}"
+BUILD_STAMP="${BUILD_STAMP:-$(date '+%Y-%m-%d-%H%M')}"
+APP_MODFILE="${STR_APP_MODFILE:-$APPDIR/go.android.mod}"
+ROOT_MODFILE="${STR_ROOT_MODFILE:-$ROOT/go.mod}"
+MIN_SDK=26
+TARGET_SDK=35
+
+OUT="$HERE/app/build/apk-process"
+WORK="$OUT/work"
+rm -rf "$WORK"
+mkdir -p "$WORK"
+
+log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
+need() { command -v "$1" >/dev/null || { echo "missing tool: $1 ($2)"; exit 1; }; }
+need aapt "apt install aapt"
+need zipalign "apt install zipalign"
+need apksigner "apt install apksigner"
+need javac "a JDK"
+need keytool "a JDK"
+DX="$(command -v dx || command -v dalvik-exchange || true)"
+[[ -n "$DX" ]] || { echo "missing tool: dx (apt install dalvik-exchange)"; exit 1; }
+
+# Two platform jars. Java compiles against the target API. Resources link
+# against API 33, because the legacy aapt in Debian/Ubuntu cannot parse the
+# resource table format of newer platforms; framework resource IDs are stable
+# across API levels, so this changes nothing in the result.
+fetch_jar() {
+  local api="$1" dst="$2"
+  [[ -f "$dst" ]] && return
+  log "fetching android.jar (API $api)"
+  mkdir -p "$(dirname "$dst")"
+  curl -fL -o "$dst.tmp" "https://raw.githubusercontent.com/Sable/android-platforms/master/android-$api/android.jar"
+  mv "$dst.tmp" "$dst"
+}
+ANDROID_JAR="${ANDROID_JAR:-$HOME/.cache/str-android/android-$TARGET_SDK.jar}"
+ANDROID_RES_JAR="${ANDROID_RES_JAR:-$HOME/.cache/str-android/android-33.jar}"
+fetch_jar "$TARGET_SDK" "$ANDROID_JAR"
+fetch_jar 33 "$ANDROID_RES_JAR"
+
+# Same scheme as build.sh: v0.9.95-7-gabc -> 99507.
+version_code() {
+  local v="${1#v}" maj min pat extra
+  IFS=.- read -r maj min pat extra _ <<<"$v" || true
+  [[ "$maj" =~ ^[0-9]+$ ]] || { echo 1; return; }
+  [[ "$min" =~ ^[0-9]+$ ]] || min=0
+  [[ "$pat" =~ ^[0-9]+$ ]] || pat=0
+  [[ "$extra" =~ ^[0-9]+$ ]] || extra=0
+  (( extra > 99 )) && extra=99
+  echo $(( maj * 1000000 + min * 10000 + pat * 100 + extra ))
+}
+VERSION_CODE="$(version_code "$VERSION")"
+VERSION_NAME="${VERSION#v}"
+log "version $VERSION (code $VERSION_CODE)"
+
+# ---- 1. speaker agent, engine, frontend: shared with build.sh -------------------------
+log "building the speaker agent (linux/arm, GOARM=5)"
+( cd "$ROOT" && GOOS=linux GOARCH=arm GOARM=5 CGO_ENABLED=0 \
+    "$GO" build -modfile="$ROOT_MODFILE" -trimpath \
+    -ldflags="-s -w -X main.version=$VERSION -X main.buildStamp=$BUILD_STAMP" \
+    -o "$WORK/streborn-armv7l" ./cmd/agent )
+
+ENGINE="$APPDIR/agentbin/go-librespot-armv7l"
+if [[ "${WITH_ENGINE:-0}" == 1 ]]; then
+  log "fetching go-librespot-armv7l from the latest release"
+  curl -fL -o "$WORK/go-librespot-armv7l" \
+    https://github.com/JRpersonal/streborn/releases/latest/download/go-librespot-armv7l
+  ENGINE="$WORK/go-librespot-armv7l"
+fi
+
+log "building the frontend"
+( cd "$APPDIR/frontend"
+  [[ -d node_modules ]] || npm ci --no-audit --no-fund
+  npx vite build --outDir "$WORK/assets/web" --emptyOutDir --logLevel warn )
+cp "$SRC/js/android-shim.js" "$SRC/js/android.css" "$WORK/assets/web/"
+python3 - "$WORK/assets/web/index.html" <<'PY'
+import re, sys
+p = sys.argv[1]
+s = open(p, encoding="utf-8").read()
+inject = ('<script src="./android-shim.js"></script>\n'
+          '    <link rel="stylesheet" href="./android.css"/>\n')
+if "android-shim.js" not in s:
+    s = re.sub(r'<meta content="width=device-width[^"]*" name="viewport"\s*/?>',
+               '<meta content="width=device-width, initial-scale=1.0, viewport-fit=cover" name="viewport"/>', s)
+    s = s.replace("</title>", "</title>\n    " + inject, 1)
+open(p, "w", encoding="utf-8").write(s)
+PY
+
+# ---- 2. the Go core as an android/arm64 executable --------------------------------------
+GOROOT_SRC="$("$GO" env GOROOT)/src"
+OV="$WORK/overlay"
+mkdir -p "$OV"
+sed -e 's/^func interfaceTable(/func interfaceTableNetlink(/' \
+    -e 's/syscall\.NetlinkRIB(/netlinkRIBCompat(/g' \
+    "$GOROOT_SRC/net/interface_linux.go" > "$OV/interface_linux.go"
+sed -e 's#"/etc/resolv.conf"#strResolvConfPath()#g' \
+    "$GOROOT_SRC/net/dnsclient_unix.go" > "$OV/dnsclient_unix.go"
+grep -q interfaceTableNetlink "$OV/interface_linux.go" && grep -q strResolvConfPath "$OV/dnsclient_unix.go" \
+  || { echo "net overlay: the standard library changed shape; see android/goport"; exit 1; }
+python3 - "$WORK/overlay.json" <<PY
+import json, sys
+json.dump({"Replace": {
+    "$GOROOT_SRC/net/interface_linux.go": "$OV/interface_linux.go",
+    "$GOROOT_SRC/net/dnsclient_unix.go": "$OV/dnsclient_unix.go",
+    "$GOROOT_SRC/net/interface_android_str.go": "$HERE/goport/overlay/interface_android_str.go",
+    "$APPDIR/agentbin/streborn-armv7l": "$WORK/streborn-armv7l",
+    "$APPDIR/agentbin/go-librespot-armv7l": "$ENGINE",
+}}, open(sys.argv[1], "w"), indent=1)
+PY
+
+log "building the core (android/arm64, no cgo)"
+mkdir -p "$WORK/apk/lib/arm64-v8a"
+( cd "$APPDIR" && GOOS=android GOARCH=arm64 CGO_ENABLED=0 \
+    "$GO" build -modfile="$APP_MODFILE" -overlay="$WORK/overlay.json" -trimpath \
+    -ldflags="-s -w -X main.appVersion=$VERSION -X main.appBuild=$BUILD_STAMP" \
+    -o "$WORK/apk/lib/arm64-v8a/libstrcore.so" . )
+
+# ---- 3. resources and R.java ------------------------------------------------------------
+log "compiling resources"
+mkdir -p "$WORK/gen" "$WORK/classes"
+# Gradle injects the package from build.gradle's namespace; aapt wants it in
+# the manifest itself.
+sed 's#<manifest xmlns:android="http://schemas.android.com/apk/res/android">#<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="de.streborn.android">#' \
+  "$SRC/AndroidManifest.xml" > "$WORK/AndroidManifest.xml"
+grep -q 'package="de.streborn.android"' "$WORK/AndroidManifest.xml" || { echo "manifest: could not set package"; exit 1; }
+aapt package -f -m \
+  -M "$WORK/AndroidManifest.xml" \
+  -S "$SRC/res" \
+  -A "$WORK/assets" \
+  -I "$ANDROID_RES_JAR" \
+  -J "$WORK/gen" \
+  --min-sdk-version "$MIN_SDK" --target-sdk-version "$TARGET_SDK" \
+  --version-code "$VERSION_CODE" --version-name "$VERSION_NAME" \
+  -0 so \
+  -F "$WORK/unsigned.apk"
+
+# Gradle generates BuildConfig; here it is written by hand.
+mkdir -p "$WORK/gen/de/streborn/android"
+cat > "$WORK/gen/de/streborn/android/BuildConfig.java" <<EOF
+package de.streborn.android;
+
+public final class BuildConfig {
+    public static final boolean DEBUG = false;
+    public static final String APPLICATION_ID = "de.streborn.android";
+    public static final String VERSION_NAME = "$VERSION_NAME";
+    public static final int VERSION_CODE = $VERSION_CODE;
+}
+EOF
+
+# ---- 4. Java -> dex --------------------------------------------------------------------
+log "compiling Java"
+find "$SRC/java" "$WORK/gen" -name '*.java' > "$WORK/sources.txt"
+javac -nowarn -Xlint:-options -source 8 -target 8 -encoding UTF-8 \
+  -bootclasspath "$ANDROID_JAR" -d "$WORK/classes" @"$WORK/sources.txt"
+"$DX" --dex --min-sdk-version="$MIN_SDK" --output="$WORK/apk/classes.dex" "$WORK/classes"
+
+# ---- 5. assemble, align, sign ----------------------------------------------------------
+log "assembling the APK"
+( cd "$WORK/apk" && zip -q -r "$WORK/unsigned.apk" classes.dex lib )
+zipalign -f -p 4 "$WORK/unsigned.apk" "$WORK/aligned.apk"
+
+if [[ -n "${STR_KEYSTORE:-}" ]]; then
+  KS="$STR_KEYSTORE"; KS_PASS="$STR_KEYSTORE_PASSWORD"; KEY_ALIAS="$STR_KEY_ALIAS"; KEY_PASS="${STR_KEY_PASSWORD:-$STR_KEYSTORE_PASSWORD}"
+else
+  KS="$HOME/.android/str-local.keystore"; KS_PASS=strlocal; KEY_ALIAS=str; KEY_PASS=strlocal
+  if [[ ! -f "$KS" ]]; then
+    log "creating a local signing key ($KS); keep it to install later builds as updates"
+    mkdir -p "$(dirname "$KS")"
+    keytool -genkeypair -noprompt -keystore "$KS" -storepass "$KS_PASS" -keypass "$KEY_PASS" \
+      -alias "$KEY_ALIAS" -keyalg RSA -keysize 3072 -validity 10000 \
+      -dname "CN=ST Reborn local build" >/dev/null 2>&1
+  fi
+fi
+FINAL="$OUT/STR-Android-$VERSION-arm64.apk"
+apksigner sign --ks "$KS" --ks-pass "pass:$KS_PASS" --key-pass "pass:$KEY_PASS" --ks-key-alias "$KEY_ALIAS" \
+  --min-sdk-version "$MIN_SDK" --v4-signing-enabled false --out "$FINAL" "$WORK/aligned.apk"
+apksigner verify --min-sdk-version "$MIN_SDK" "$FINAL"
+( cd "$OUT" && sha256sum "$(basename "$FINAL")" > "$(basename "$FINAL").sha256" )
+log "done: $FINAL"

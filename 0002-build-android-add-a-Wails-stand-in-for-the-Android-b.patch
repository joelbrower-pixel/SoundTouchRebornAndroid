+++ b/android/wailsshim/pkg/runtime/runtime.go
@@ -0,0 +1,280 @@
+// Package runtime is the Android stand-in for github.com/wailsapp/wails/v2/pkg/runtime.
+//
+// Signatures match Wails v2.16. The context argument is accepted and ignored:
+// there is one app and one WebView per process on Android, so there is nothing
+// for it to select.
+//
+// Mapping:
+//   - Events go to the WebView through pkg/mobile's queue.
+//   - Open dialogs use the system document picker; save dialogs stage the
+//     file and hand it to the system "Save as" picker afterwards.
+//   - Message dialogs become an Android AlertDialog.
+//   - BrowserOpenURL and the clipboard go to the platform.
+//   - Window and screen calls have no meaning for a full-screen activity and
+//     are no-ops; ScreenGetAll reports an error so size-fitting code skips.
+package runtime
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"log"
+	"runtime"
+	"time"
+
+	"github.com/wailsapp/wails/v2/pkg/mobile"
+)
+
+// ---- types (mirrors internal/frontend) --------------------------------------
+
+type FileFilter struct {
+	DisplayName string // Filter information EG: "Image Files (*.jpg, *.png)"
+	Pattern     string // semicolon separated list of extensions, EG: "*.jpg;*.png"
+}
+
+type OpenDialogOptions struct {
+	DefaultDirectory           string
+	DefaultFilename            string
+	Title                      string
+	Filters                    []FileFilter
+	ShowHiddenFiles            bool
+	CanCreateDirectories       bool
+	ResolvesAliases            bool
+	TreatPackagesAsDirectories bool
+}
+
+type SaveDialogOptions struct {
+	DefaultDirectory           string
+	DefaultFilename            string
+	Title                      string
+	Filters                    []FileFilter
+	ShowHiddenFiles            bool
+	CanCreateDirectories       bool
+	TreatPackagesAsDirectories bool
+}
+
+type DialogType string
+
+const (
+	InfoDialog     DialogType = "info"
+	WarningDialog  DialogType = "warning"
+	ErrorDialog    DialogType = "error"
+	QuestionDialog DialogType = "question"
+)
+
+type MessageDialogOptions struct {
+	Type          DialogType
+	Title         string
+	Message       string
+	Buttons       []string
+	DefaultButton string
+	CancelButton  string
+	Icon          []byte
+}
+
+type Screen struct {
+	IsCurrent    bool       `json:"isCurrent"`
+	IsPrimary    bool       `json:"isPrimary"`
+	Width        int        `json:"width"`
+	Height       int        `json:"height"`
+	Size         ScreenSize `json:"size"`
+	PhysicalSize ScreenSize `json:"physicalSize"`
+}
+
+type ScreenSize struct {
+	Width  int `json:"width"`
+	Height int `json:"height"`
+}
+
+type EnvironmentInfo struct {
+	BuildType string `json:"buildType"`
+	Platform  string `json:"platform"`
+	Arch      string `json:"arch"`
+}
+
+// ---- events -----------------------------------------------------------------
+
+func EventsEmit(_ context.Context, eventName string, optionalData ...interface{}) {
+	mobile.Emit(eventName, optionalData...)
+}
+
+func EventsOn(_ context.Context, eventName string, callback func(optionalData ...interface{})) func() {
+	return mobile.On(eventName, callback, -1)
+}
+
+func EventsOnce(_ context.Context, eventName string, callback func(optionalData ...interface{})) func() {
+	return mobile.On(eventName, callback, 1)
+}
+
+func EventsOnMultiple(_ context.Context, eventName string, callback func(optionalData ...interface{}), counter int) func() {
+	return mobile.On(eventName, callback, counter)
+}
+
+func EventsOff(_ context.Context, eventName string, additionalEventNames ...string) {
+	mobile.Off(append([]string{eventName}, additionalEventNames...)...)
+}
+
+func EventsOffAll(_ context.Context) { mobile.OffAll() }
+
+// ---- dialogs ----------------------------------------------------------------
+
+func patterns(fs []FileFilter) []string {
+	out := make([]string, 0, len(fs))
+	for _, f := range fs {
+		out = append(out, f.Pattern)
+	}
+	return out
+}
+
+func OpenFileDialog(_ context.Context, o OpenDialogOptions) (string, error) {
+	return mobile.PickFile(o.Title, patterns(o.Filters))
+}
+
+func OpenMultipleFilesDialog(ctx context.Context, o OpenDialogOptions) ([]string, error) {
+	p, err := OpenFileDialog(ctx, o)
+	if err != nil || p == "" {
+		return nil, err
+	}
+	return []string{p}, nil
+}
+
+func OpenDirectoryDialog(_ context.Context, _ OpenDialogOptions) (string, error) {
+	return "", errors.New("choosing a folder is not available on Android")
+}
+
+func SaveFileDialog(_ context.Context, o SaveDialogOptions) (string, error) {
+	return mobile.StageExport(o.DefaultFilename, o.Title, patterns(o.Filters))
+}
+
+func MessageDialog(_ context.Context, o MessageDialogOptions) (string, error) {
+	buttons := o.Buttons
+	if len(buttons) == 0 {
+		if o.Type == QuestionDialog {
+			buttons = []string{"Yes", "No"}
+		} else {
+			buttons = []string{"OK"}
+		}
+	}
+	raw, err := mobile.HostRequest("messageDialog", map[string]any{
+		"type":          string(o.Type),
+		"title":         o.Title,
+		"message":       o.Message,
+		"buttons":       buttons,
+		"defaultButton": o.DefaultButton,
+		"cancelButton":  o.CancelButton,
+	}, 30*time.Minute)
+	if err != nil {
+		return "", err
+	}
+	var ans struct {
+		Button string `json:"button"`
+	}
+	if err := json.Unmarshal(raw, &ans); err != nil {
+		return "", err
+	}
+	if ans.Button == "" {
+		if o.CancelButton != "" {
+			return o.CancelButton, nil
+		}
+		return buttons[len(buttons)-1], nil
+	}
+	return ans.Button, nil
+}
+
+func OnFileDrop(_ context.Context, _ func(x, y int, paths []string)) {}
+func OnFileDropOff(_ context.Context)                                {}
+
+// ---- browser and clipboard ---------------------------------------------------
+
+func BrowserOpenURL(_ context.Context, url string) {
+	mobile.HostNotify("openURL", map[string]any{"url": url})
+}
+
+func ClipboardSetText(_ context.Context, text string) error {
+	mobile.HostNotify("clipboardSet", map[string]any{"text": text})
+	return nil
+}
+
+func ClipboardGetText(_ context.Context) (string, error) {
+	raw, err := mobile.HostRequest("clipboardGet", nil, 10*time.Second)
+	if err != nil {
+		return "", err
+	}
+	var ans struct {
+		Text string `json:"text"`
+	}
+	err = json.Unmarshal(raw, &ans)
+	return ans.Text, err
+}
+
+// ---- app lifecycle ------------------------------------------------------------
+
+func Quit(_ context.Context) { mobile.HostNotify("quit", nil) }
+func Hide(_ context.Context) {}
+func Show(_ context.Context) {}
+
+func Environment(_ context.Context) EnvironmentInfo {
+	return EnvironmentInfo{BuildType: "production", Platform: runtime.GOOS, Arch: runtime.GOARCH}
+}
+
+// ---- screen and window: no meaning for a full-screen activity --------------------
+
+var errNoScreen = errors.New("screen information is not available on Android")
+
+func ScreenGetAll(_ context.Context) ([]Screen, error) { return nil, errNoScreen }
+
+func WindowSetTitle(_ context.Context, _ string)        {}
+func WindowFullscreen(_ context.Context)                {}
+func WindowUnfullscreen(_ context.Context)              {}
+func WindowCenter(_ context.Context)                    {}
+func WindowReload(_ context.Context)                    { mobile.HostNotify("reload", nil) }
+func WindowReloadApp(_ context.Context)                 { mobile.HostNotify("reload", nil) }
+func WindowSetSystemDefaultTheme(_ context.Context)     {}
+func WindowSetLightTheme(_ context.Context)             {}
+func WindowSetDarkTheme(_ context.Context)              {}
+func WindowShow(_ context.Context)                      {}
+func WindowHide(_ context.Context)                      {}
+func WindowSetSize(_ context.Context, _ int, _ int)     {}
+func WindowGetSize(_ context.Context) (int, int)        { return 0, 0 }
+func WindowSetMinSize(_ context.Context, _ int, _ int)  {}
+func WindowSetMaxSize(_ context.Context, _ int, _ int)  {}
+func WindowSetAlwaysOnTop(_ context.Context, _ bool)    {}
+func WindowSetPosition(_ context.Context, _ int, _ int) {}
+func WindowGetPosition(_ context.Context) (int, int)    { return 0, 0 }
+func WindowMaximise(_ context.Context)                  {}
+func WindowToggleMaximise(_ context.Context)            {}
+func WindowUnmaximise(_ context.Context)                {}
+func WindowMinimise(_ context.Context)                  {}
+func WindowUnminimise(_ context.Context)                {}
+func WindowIsFullscreen(_ context.Context) bool         { return true }
+func WindowIsMaximised(_ context.Context) bool          { return true }
+func WindowIsMinimised(_ context.Context) bool          { return false }
+func WindowIsNormal(_ context.Context) bool             { return false }
+func WindowExecJS(_ context.Context, js string) {
+	mobile.HostNotify("execJS", map[string]any{"js": js})
+}
+func WindowSetBackgroundColour(_ context.Context, _, _, _, _ uint8) {}
+func WindowPrint(_ context.Context)                                 {}
+
+// ---- logging: Wails' log functions go to the standard logger (logcat) ------------
+
+func LogPrint(_ context.Context, message string)   { log.Print(message) }
+func LogTrace(_ context.Context, message string)   { log.Print("TRACE " + message) }
+func LogDebug(_ context.Context, message string)   { log.Print("DEBUG " + message) }
+func LogInfo(_ context.Context, message string)    { log.Print("INFO " + message) }
+func LogWarning(_ context.Context, message string) { log.Print("WARN " + message) }
+func LogError(_ context.Context, message string)   { log.Print("ERROR " + message) }
+func LogFatal(_ context.Context, message string)   { log.Print("FATAL " + message) }
+
+func LogPrintf(ctx context.Context, f string, a ...interface{}) { LogPrint(ctx, fmt.Sprintf(f, a...)) }
+func LogTracef(ctx context.Context, f string, a ...interface{}) { LogTrace(ctx, fmt.Sprintf(f, a...)) }
+func LogDebugf(ctx context.Context, f string, a ...interface{}) { LogDebug(ctx, fmt.Sprintf(f, a...)) }
+func LogInfof(ctx context.Context, f string, a ...interface{})  { LogInfo(ctx, fmt.Sprintf(f, a...)) }
+func LogWarningf(ctx context.Context, f string, a ...interface{}) {
+	LogWarning(ctx, fmt.Sprintf(f, a...))
+}
+func LogErrorf(ctx context.Context, f string, a ...interface{}) { LogError(ctx, fmt.Sprintf(f, a...)) }
+func LogFatalf(ctx context.Context, f string, a ...interface{}) { LogFatal(ctx, fmt.Sprintf(f, a...)) }
+
+func ResetSignalHandlers() {}
diff --git a/android/wailsshim/wails.go b/android/wailsshim/wails.go
new file mode 100644
index 00000000..afd39420
--- /dev/null
+++ b/android/wailsshim/wails.go
@@ -0,0 +1,204 @@
+// Package wails is the Android stand-in for github.com/wailsapp/wails/v2.
+//
+// On Android, Run is never reached: the app is built as a shared library whose
+// main() the platform never calls, and desktop-app/mobile_android.go starts
+// the app instead.
+//
+// On a desktop OS, Run turns the Android build of the core into a browser dev
+// harness. `go run -modfile=go.android.mod .` in desktop-app serves the
+// frontend with the Android shim at http://127.0.0.1:34115 and carries the
+// bridge over HTTP instead of JNI, so the exact code the phone runs can be
+// exercised and inspected in any browser, at phone size, with devtools. The
+// port is the one `wails dev` uses, which STR speaker agents already allow as
+// a CORS origin, so the harness works against real speakers too.
+package wails
+
+import (
+	"context"
+	_ "embed"
+	"encoding/json"
+	"errors"
+	"io"
+	"io/fs"
+	"log"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"time"
+
+	"github.com/wailsapp/wails/v2/pkg/mobile"
+	"github.com/wailsapp/wails/v2/pkg/options"
+)
+
+//go:embed devhost.js
+var devHostJS []byte
+
+// Run starts the browser dev harness (desktop OS only).
+func Run(o *options.App) error {
+	if runtime.GOOS == "android" {
+		return errors.New("wails.Run is not available on Android; the app is started by the Android host")
+	}
+	for _, b := range o.Bind {
+		mobile.Bind(b)
+	}
+	if dir, err := os.MkdirTemp("", "str-harness-"); err == nil {
+		mobile.SetCacheDir(dir)
+	}
+	ctx := context.Background()
+	if o.OnStartup != nil {
+		o.OnStartup(ctx)
+	}
+	go answerHostRequests()
+
+	web, err := webRoot(o)
+	if err != nil {
+		return err
+	}
+	shimDir := os.Getenv("STR_SHIM_DIR")
+	if shimDir == "" {
+		shimDir = filepath.Join("..", "android", "app", "src", "main", "js")
+	}
+
+	mux := http.NewServeMux()
+	mux.HandleFunc("/__str/devhost.js", func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Content-Type", "text/javascript")
+		_, _ = w.Write(devHostJS)
+	})
+	mux.HandleFunc("/android-shim.js", func(w http.ResponseWriter, r *http.Request) {
+		http.ServeFile(w, r, filepath.Join(shimDir, "android-shim.js"))
+	})
+	mux.HandleFunc("/android.css", func(w http.ResponseWriter, r *http.Request) {
+		http.ServeFile(w, r, filepath.Join(shimDir, "android.css"))
+	})
+	mux.HandleFunc("/__str/call", func(w http.ResponseWriter, r *http.Request) {
+		var req struct {
+			Method string          `json:"method"`
+			Args   json.RawMessage `json:"args"`
+		}
+		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write(mobile.Call(req.Method, string(req.Args)))
+	})
+	mux.HandleFunc("/__str/emit", func(w http.ResponseWriter, r *http.Request) {
+		var req struct {
+			Name string          `json:"name"`
+			Data json.RawMessage `json:"data"`
+		}
+		_ = json.NewDecoder(r.Body).Decode(&req)
+		mobile.Dispatch(req.Name, string(req.Data))
+	})
+	mux.HandleFunc("/__str/events", func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write(append(append([]byte("["), drainEvents()...), ']'))
+	})
+	mux.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
+		p := strings.TrimPrefix(r.URL.Path, "/")
+		if p == "" || p == "index.html" {
+			b, err := fs.ReadFile(web, "index.html")
+			if err != nil {
+				http.Error(w, "frontend not built: run `npm run build` in desktop-app/frontend", http.StatusNotFound)
+				return
+			}
+			s := strings.Replace(string(b), "</title>", "</title>\n"+
+				`    <script src="/__str/devhost.js"></script>`+"\n"+
+				`    <script src="/android-shim.js"></script>`+"\n"+
+				`    <link rel="stylesheet" href="/android.css"/>`, 1)
+			w.Header().Set("Content-Type", "text/html; charset=utf-8")
+			_, _ = io.WriteString(w, s)
+			return
+		}
+		http.FileServer(http.FS(web)).ServeHTTP(w, r)
+	})
+
+	addr := os.Getenv("STR_DEV_ADDR")
+	if addr == "" {
+		addr = "127.0.0.1:34115"
+	}
+	ln, err := net.Listen("tcp", addr)
+	if err != nil {
+		return err
+	}
+	log.Printf("STR Android dev harness: open http://%s/ (narrow the window or use device mode for phone size)", ln.Addr())
+	return http.Serve(ln, mux)
+}
+
+// webRoot is the built frontend: STR_WEB_DIR when set, else the embedded copy.
+func webRoot(o *options.App) (fs.FS, error) {
+	if d := os.Getenv("STR_WEB_DIR"); d != "" {
+		return os.DirFS(d), nil
+	}
+	if o.AssetServer == nil || o.AssetServer.Assets == nil {
+		return nil, errors.New("no frontend assets; set STR_WEB_DIR")
+	}
+	sub, err := fs.Sub(o.AssetServer.Assets, "frontend/dist")
+	if err != nil {
+		return o.AssetServer.Assets, nil
+	}
+	return sub, nil
+}
+
+// drainEvents long-polls the queue: waits up to 25 s for the first item, then
+// takes whatever else is already queued. Host requests are answered by
+// answerHostRequests and never reach the page.
+func drainEvents() []byte {
+	var out []byte
+	first := true
+	for {
+		wait := time.Duration(0)
+		if first {
+			wait = 25 * time.Second
+		}
+		b := mobile.NextEvent(wait)
+		if b == nil {
+			return out
+		}
+		first = false
+		if handledAsHost(b) {
+			continue
+		}
+		if len(out) > 0 {
+			out = append(out, ',')
+		}
+		out = append(out, b...)
+	}
+}
+
+// Host requests in the harness. There is no platform to ask, so the answers
+// are the "user cancelled" ones, and the request is logged.
+var hostQueue = make(chan mobile.Event, 64)
+
+func handledAsHost(b []byte) bool {
+	var ev mobile.Event
+	if json.Unmarshal(b, &ev) != nil || ev.Kind != "host" {
+		return false
+	}
+	hostQueue <- ev
+	return true
+}
+
+func answerHostRequests() {
+	for ev := range hostQueue {
+		args, _ := json.Marshal(ev.Args)
+		log.Printf("harness: host request %q %s", ev.Op, args)
+		if ev.ID == 0 {
+			continue
+		}
+		var reply any = map[string]string{}
+		switch ev.Op {
+		case "openFile":
+			reply = map[string]string{"path": ""}
+		case "messageDialog":
+			reply = map[string]string{"button": ""}
+		case "clipboardGet":
+			reply = map[string]string{"text": ""}
+		}
+		b, _ := json.Marshal(reply)
+		mobile.HostReply(ev.ID, b)
+	}
+}

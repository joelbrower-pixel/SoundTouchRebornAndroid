From 053c02783315dc8f57c1b004b61ec045ec076f15 Mon Sep 17 00:00:00 2001
From: Joel Brower <joel.brower@gmail.com>
Date: Sat, 3 Oct 2026 00:22:38 -0500
Subject: [PATCH 3/6] build(android): build the desktop app as an Android
 shared library

go.android.mod is go.mod plus a replace that swaps in the Wails stand-in.
mobile_android.go and mobile_jni.c (both android-only by build constraint)
start the unchanged App and expose the bridge to Java over JNI. Desktop
builds are unaffected: go.mod is untouched and the new files never build
outside Android.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016wzfhQtsFu3EKKkUkehQyh
---
 desktop-app/go.android.mod    |  56 ++++++++++
 desktop-app/go.android.sum    | 113 ++++++++++++++++++++
 desktop-app/mobile_android.go | 190 ++++++++++++++++++++++++++++++++++
 desktop-app/mobile_jni.c      |  80 ++++++++++++++
 4 files changed, 439 insertions(+)
 create mode 100644 desktop-app/go.android.mod
 create mode 100644 desktop-app/go.android.sum
 create mode 100644 desktop-app/mobile_android.go
 create mode 100644 desktop-app/mobile_jni.c

diff --git a/desktop-app/go.android.mod b/desktop-app/go.android.mod
new file mode 100644
index 00000000..4d9b7120
--- /dev/null
+++ b/desktop-app/go.android.mod
@@ -0,0 +1,56 @@
+module streborn-app
+
+go 1.26.0
+
+require (
+	github.com/JRpersonal/streborn v0.0.0
+	github.com/skip2/go-qrcode v0.0.0-20200617195104-da1b6568686e
+	github.com/tc-hib/winres v0.3.1
+	github.com/wailsapp/wails/v2 v2.16.0
+	golang.org/x/crypto v0.57.0
+	golang.org/x/sys v0.48.0
+)
+
+require github.com/grandcat/zeroconf v1.0.0 // indirect
+
+require github.com/miekg/dns v1.1.73 // indirect
+
+replace github.com/JRpersonal/streborn => ..
+
+require (
+	git.sr.ht/~jackmordaunt/go-toast/v2 v2.0.3 // indirect
+	github.com/bep/debounce v1.2.1 // indirect
+	github.com/cenkalti/backoff v2.2.1+incompatible // indirect
+	github.com/go-ole/go-ole v1.3.0 // indirect
+	github.com/godbus/dbus/v5 v5.1.0 // indirect
+	github.com/google/uuid v1.6.0 // indirect
+	github.com/gorilla/websocket v1.5.3 // indirect
+	github.com/jchv/go-winloader v0.0.0-20210711035445-715c2860da7e // indirect
+	github.com/labstack/echo/v4 v4.15.3 // indirect
+	github.com/labstack/gommon v0.5.0 // indirect
+	github.com/leaanthony/go-ansi-parser v1.6.1 // indirect
+	github.com/leaanthony/gosod v1.0.4 // indirect
+	github.com/leaanthony/slicer v1.6.0 // indirect
+	github.com/leaanthony/u v1.1.1 // indirect
+	github.com/mattn/go-colorable v0.1.14 // indirect
+	github.com/mattn/go-isatty v0.0.22 // indirect
+	github.com/nfnt/resize v0.0.0-20180221191011-83c6a9932646 // indirect
+	github.com/pkg/browser v0.0.0-20240102092130-5ac0b6a4141c // indirect
+	github.com/pkg/errors v0.9.1 // indirect
+	github.com/rivo/uniseg v0.4.7 // indirect
+	github.com/samber/lo v1.49.1 // indirect
+	github.com/tkrajina/go-reflector v0.5.8 // indirect
+	github.com/valyala/bytebufferpool v1.0.0 // indirect
+	github.com/valyala/fasttemplate v1.2.2 // indirect
+	github.com/wailsapp/go-webview2 v1.0.22 // indirect
+	github.com/wailsapp/mimetype v1.4.1 // indirect
+	golang.org/x/image v0.41.0 // indirect
+	golang.org/x/net v0.59.0 // indirect
+	golang.org/x/text v0.42.0 // indirect
+)
+
+// Android build only (android/goport/build-go.sh passes -modfile=go.android.mod).
+// Wails v2 has no Android target; this swaps in the stand-in module that maps
+// its runtime calls onto the Android host. go.mod is untouched, so the desktop
+// builds are unaffected.
+replace github.com/wailsapp/wails/v2 => ../android/wailsshim

new file mode 100644
index 00000000..7d5d5b63
--- /dev/null
+++ b/desktop-app/mobile_jni.c
@@ -0,0 +1,80 @@
+//go:build android
+
+// JNI glue for the Android host's de.streborn.android.GoBridge class.
+//
+// A .c file rather than a cgo preamble: these functions call the //export'ed
+// Go functions through _cgo_export.h, which only exists once cgo has processed
+// the Go files, so they cannot sit in a preamble. The build constraint above
+// keeps the file out of every desktop build (Go applies constraints to .c
+// files too).
+//
+// Strings cross as UTF-8 byte arrays, not jstring: JNI's string functions
+// speak "modified UTF-8", which encodes characters outside the BMP (emoji in
+// station names) in a form Go would read as invalid UTF-8.
+
+#include <jni.h>
+#include <stdlib.h>
+#include <android/log.h>
+#include "_cgo_export.h"
+
+static jbyteArray strToJava(JNIEnv* env, void* p, int n) {
+	if (p == NULL) return NULL;
+	jbyteArray arr = (*env)->NewByteArray(env, n);
+	if (arr != NULL) (*env)->SetByteArrayRegion(env, arr, 0, n, (const jbyte*)p);
+	free(p);
+	return arr;
+}
+
+JNIEXPORT void JNICALL Java_de_streborn_android_GoBridge_start(JNIEnv* env, jclass cls, jbyteArray cfg) {
+	jsize n = (*env)->GetArrayLength(env, cfg);
+	jbyte* b = (*env)->GetByteArrayElements(env, cfg, NULL);
+	strStart((char*)b, n);
+	(*env)->ReleaseByteArrayElements(env, cfg, b, JNI_ABORT);
+}
+
+JNIEXPORT jbyteArray JNICALL Java_de_streborn_android_GoBridge_call(JNIEnv* env, jclass cls, jbyteArray method, jbyteArray args) {
+	jsize mn = (*env)->GetArrayLength(env, method);
+	jsize an = (*env)->GetArrayLength(env, args);
+	jbyte* m = (*env)->GetByteArrayElements(env, method, NULL);
+	jbyte* a = (*env)->GetByteArrayElements(env, args, NULL);
+	int outLen = 0;
+	void* out = strCall((char*)m, mn, (char*)a, an, &outLen);
+	(*env)->ReleaseByteArrayElements(env, method, m, JNI_ABORT);
+	(*env)->ReleaseByteArrayElements(env, args, a, JNI_ABORT);
+	return strToJava(env, out, outLen);
+}
+
+JNIEXPORT jbyteArray JNICALL Java_de_streborn_android_GoBridge_nextEvent(JNIEnv* env, jclass cls, jint timeoutMs) {
+	int outLen = 0;
+	void* out = strNextEvent(timeoutMs, &outLen);
+	return strToJava(env, out, outLen);
+}
+
+JNIEXPORT void JNICALL Java_de_streborn_android_GoBridge_hostReply(JNIEnv* env, jclass cls, jlong id, jbyteArray payload) {
+	jsize n = (*env)->GetArrayLength(env, payload);
+	jbyte* b = (*env)->GetByteArrayElements(env, payload, NULL);
+	strHostReply(id, (char*)b, n);
+	(*env)->ReleaseByteArrayElements(env, payload, b, JNI_ABORT);
+}
+
+JNIEXPORT void JNICALL Java_de_streborn_android_GoBridge_emit(JNIEnv* env, jclass cls, jbyteArray name, jbyteArray data) {
+	jsize nn = (*env)->GetArrayLength(env, name);
+	jsize dn = (*env)->GetArrayLength(env, data);
+	jbyte* nb = (*env)->GetByteArrayElements(env, name, NULL);
+	jbyte* db = (*env)->GetByteArrayElements(env, data, NULL);
+	strEmit((char*)nb, nn, (char*)db, dn);
+	(*env)->ReleaseByteArrayElements(env, name, nb, JNI_ABORT);
+	(*env)->ReleaseByteArrayElements(env, data, db, JNI_ABORT);
+}
+
+JNIEXPORT jboolean JNICALL Java_de_streborn_android_GoBridge_beforeClose(JNIEnv* env, jclass cls) {
+	return strBeforeClose() ? JNI_TRUE : JNI_FALSE;
+}
+
+JNIEXPORT jboolean JNICALL Java_de_streborn_android_GoBridge_busy(JNIEnv* env, jclass cls) {
+	return strBusy() ? JNI_TRUE : JNI_FALSE;
+}
+
+void strLogcat(int prio, const char* msg) {
+	__android_log_write(prio, "STR", msg);
+}

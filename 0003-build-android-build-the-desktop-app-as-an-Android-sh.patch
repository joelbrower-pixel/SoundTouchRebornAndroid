diff --git a/desktop-app/mobile_android.go b/desktop-app/mobile_android.go
new file mode 100644
index 00000000..a9f78a8c
--- /dev/null
+++ b/desktop-app/mobile_android.go
@@ -0,0 +1,190 @@
+//go:build android
+
+package main
+
+// Android entry point.
+//
+// On Android the desktop app is built as a shared library (libstr.so) that the
+// host app (android/app) loads into its own process. main() never runs; the
+// host calls strStart once, then drives everything through the exports below.
+// The JNI side lives in mobile_jni.c.
+//
+// Nothing here changes how the app behaves. NewApp and startup are the same
+// ones wails.Run would call, the bound methods are the same ones the desktop
+// webview calls, and the Wails runtime calls they make are answered by the
+// stand-in module in android/wailsshim.
+
+/*
+#cgo LDFLAGS: -llog
+#include <stdlib.h>
+
+// Defined in mobile_jni.c.
+void strLogcat(int prio, const char* msg);
+*/
+import "C"
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"log"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+	"unsafe"
+
+	"github.com/wailsapp/wails/v2/pkg/mobile"
+)
+
+// mobileConfig is what the host passes to strStart.
+type mobileConfig struct {
+	FilesDir string            `json:"filesDir"`
+	CacheDir string            `json:"cacheDir"`
+	SDKInt   int               `json:"sdkInt"`
+	Env      map[string]string `json:"env"`
+}
+
+var (
+	mobileOnce sync.Once
+	mobileApp  *App
+	mobileCtx  context.Context
+)
+
+//export strStart
+func strStart(cfg *C.char, n C.int) {
+	mobileOnce.Do(func() {
+		var c mobileConfig
+		_ = json.Unmarshal(C.GoBytes(unsafe.Pointer(cfg), n), &c)
+		mobileSetupEnv(c)
+		mobile.SetCacheDir(c.CacheDir)
+
+		defer func() {
+			if r := recover(); r != nil {
+				logCrash("android-start", r)
+				panic(r)
+			}
+		}()
+		app := NewApp()
+		mobileApp = app
+		mobile.Bind(app)
+		mobileCtx = context.Background()
+		app.startup(mobileCtx)
+	})
+}
+
+// mobileSetupEnv gives the Go side the directory layout a desktop has. The
+// app keeps its state in os.UserConfigDir, its update cache in
+// os.UserCacheDir and its log under XDG_DATA_HOME; on Android none of those
+// are set for an app process, so they are pointed into the app's private
+// storage. The host also sets them before loading the library, which is what
+// package-level initialisers see; this is the belt to that pair of braces.
+func mobileSetupEnv(c mobileConfig) {
+	set := func(k, v string) {
+		if v != "" {
+			_ = os.Setenv(k, v)
+		}
+	}
+	if c.FilesDir != "" {
+		set("HOME", c.FilesDir)
+		set("XDG_CONFIG_HOME", filepath.Join(c.FilesDir, "config"))
+		set("XDG_DATA_HOME", filepath.Join(c.FilesDir, "data"))
+	}
+	if c.CacheDir != "" {
+		set("XDG_CACHE_HOME", c.CacheDir)
+		set("TMPDIR", filepath.Join(c.CacheDir, "tmp"))
+	}
+	for k, v := range c.Env {
+		set(k, v)
+	}
+	for _, k := range []string{"XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_CACHE_HOME", "TMPDIR"} {
+		if d := os.Getenv(k); d != "" {
+			_ = os.MkdirAll(d, 0o700)
+		}
+	}
+}
+
+// strCall runs one bound method. The returned buffer is malloc'd; the caller
+// frees it.
+//
+//export strCall
+func strCall(method *C.char, mlen C.int, args *C.char, alen C.int, outLen *C.int) unsafe.Pointer {
+	m := C.GoStringN(method, mlen)
+	a := C.GoStringN(args, alen)
+	out := mobile.Call(m, a)
+	*outLen = C.int(len(out))
+	return C.CBytes(out)
+}
+
+// strNextEvent waits up to timeoutMs for the next event or host request.
+// Returns NULL when none arrived; otherwise a malloc'd buffer.
+//
+//export strNextEvent
+func strNextEvent(timeoutMs C.int, outLen *C.int) unsafe.Pointer {
+	b := mobile.NextEvent(time.Duration(timeoutMs) * time.Millisecond)
+	if b == nil {
+		*outLen = 0
+		return nil
+	}
+	*outLen = C.int(len(b))
+	return C.CBytes(b)
+}
+
+// strHostReply answers a host request.
+//
+//export strHostReply
+func strHostReply(id C.longlong, payload *C.char, n C.int) {
+	mobile.HostReply(int64(id), C.GoBytes(unsafe.Pointer(payload), n))
+}
+
+// strEmit delivers an event the frontend emitted to Go-side listeners.
+//
+//export strEmit
+func strEmit(name *C.char, nlen C.int, data *C.char, dlen C.int) {
+	mobile.Dispatch(C.GoStringN(name, nlen), C.GoStringN(data, dlen))
+}
+
+// strBeforeClose asks the app whether leaving should be refused, the same
+// question Wails asks on a desktop window close (an update still running).
+//
+//export strBeforeClose
+func strBeforeClose() C.int {
+	if mobileApp == nil {
+		return 0
+	}
+	if mobileApp.beforeClose(mobileCtx) {
+		return 1
+	}
+	return 0
+}
+
+// logcatWriter sends the standard logger to logcat; stderr goes nowhere in an
+// Android app process. The app's own structured log still goes to str.log, as
+// on the desktop, and is what diagnostic bundles carry.
+type logcatWriter struct{}
+
+const androidLogInfo = 4 // ANDROID_LOG_INFO
+
+func (logcatWriter) Write(p []byte) (int, error) {
+	msg := C.CString(string(bytes.TrimRight(p, "\n")))
+	C.strLogcat(androidLogInfo, msg)
+	C.free(unsafe.Pointer(msg))
+	return len(p), nil
+}
+
+func init() {
+	log.SetFlags(0)
+	log.SetOutput(logcatWriter{})
+}
+
+// strBusy reports whether an install or update is running, so the host can
+// keep the screen on: a phone that dims and suspends the app mid-update is the
+// Android version of closing the window mid-update (see beforeClose).
+//
+//export strBusy
+func strBusy() C.int {
+	if otaRunning.Load() {
+		return 1
+	}
+	return 0
+}

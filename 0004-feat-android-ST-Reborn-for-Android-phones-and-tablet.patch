+++ b/android/app/src/main/java/de/streborn/android/GoBridge.java
@@ -0,0 +1,40 @@
+package de.streborn.android;
+
+import java.nio.charset.StandardCharsets;
+
+/**
+ * JNI surface of libstr.so, the STR desktop app's Go backend built as a shared
+ * library (desktop-app/mobile_android.go, desktop-app/mobile_jni.c).
+ *
+ * <p>Strings cross as UTF-8 byte arrays rather than {@code String}, because JNI's
+ * string functions use "modified UTF-8", which Go would read as invalid for any
+ * character outside the BMP (emoji in station names).
+ */
+public final class GoBridge {
+    private GoBridge() {}
+
+    static native void start(byte[] configJson);
+
+    static native byte[] call(byte[] method, byte[] argsJson);
+
+    /** Next queued event or host request as JSON, or null after the timeout. */
+    static native byte[] nextEvent(int timeoutMs);
+
+    static native void hostReply(long id, byte[] payloadJson);
+
+    static native void emit(byte[] name, byte[] dataJson);
+
+    /** True when leaving now should be refused (an update is running and the user chose to stay). */
+    static native boolean beforeClose();
+
+    /** True while an install or update runs. */
+    static native boolean busy();
+
+    static byte[] utf8(String s) {
+        return (s == null ? "" : s).getBytes(StandardCharsets.UTF_8);
+    }
+
+    static String str(byte[] b) {
+        return b == null ? null : new String(b, StandardCharsets.UTF_8);
+    }
+}
diff --git a/android/app/src/main/java/de/streborn/android/HostBridge.java b/android/app/src/main/java/de/streborn/android/HostBridge.java
new file mode 100644
index 00000000..20afe18b
--- /dev/null
+++ b/android/app/src/main/java/de/streborn/android/HostBridge.java
@@ -0,0 +1,383 @@
+package de.streborn.android;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.ActivityNotFoundException;
+import android.content.ClipData;
+import android.content.ClipboardManager;
+import android.content.Context;
+import android.content.Intent;
+import android.database.Cursor;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+import android.provider.OpenableColumns;
+import android.util.Log;
+import android.webkit.JavascriptInterface;
+import android.webkit.WebView;
+import android.widget.Toast;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * Both directions of the WebView-to-Go bridge.
+ *
+ * <ul>
+ *   <li>Exposed to JavaScript as {@code window.STRHost}; android-shim.js builds
+ *       {@code window.go} and {@code window.runtime} on top of it.
+ *   <li>Runs the event pump that drains Go's queue: frontend events are replayed
+ *       into the page, host requests (pickers, dialogs, URLs, clipboard) are
+ *       carried out here and answered with {@link GoBridge#hostReply}.
+ * </ul>
+ */
+final class HostBridge {
+    private static final String TAG = "STR";
+    static final int REQ_SAVE = 4101;
+    static final int REQ_OPEN = 4102;
+
+    private final Activity activity;
+    private final WebView webView;
+    private final Handler ui = new Handler(Looper.getMainLooper());
+    // Bound calls can block for a long time (an install waits minutes for a
+    // speaker to reboot), so each gets its own thread; a fixed pool would let
+    // a few slow calls starve every other button in the UI. Wails does the same.
+    private final ExecutorService calls = Executors.newCachedThreadPool();
+    private volatile boolean pumping;
+
+    // One picker at a time; the activity forwards its result here.
+    private JSONObject pendingSave;
+    private long pendingOpenId;
+    private String pendingOpenTarget;
+
+    HostBridge(Activity activity, WebView webView) {
+        this.activity = activity;
+        this.webView = webView;
+    }
+
+    // ---- JavaScript interface ----------------------------------------------------
+
+    @JavascriptInterface
+    public void call(final int id, final String method, final String argsJson) {
+        calls.execute(() -> {
+            String env;
+            try {
+                env = GoBridge.str(GoBridge.call(GoBridge.utf8(method), GoBridge.utf8(argsJson)));
+            } catch (Throwable t) {
+                env = errorEnvelope(String.valueOf(t));
+            }
+            if (env == null) env = errorEnvelope("no answer from the app core");
+            js("window.__strReply(" + id + "," + env + ")");
+        });
+    }
+
+    @JavascriptInterface
+    public void emit(String name, String dataJson) {
+        calls.execute(() -> GoBridge.emit(GoBridge.utf8(name), GoBridge.utf8(dataJson)));
+    }
+
+    @JavascriptInterface
+    public void openURL(String url) {
+        ui.post(() -> openExternal(url));
+    }
+
+    @JavascriptInterface
+    public void clipboardSet(String text) {
+        ui.post(() -> {
+            ClipboardManager cm = (ClipboardManager) activity.getSystemService(Context.CLIPBOARD_SERVICE);
+            if (cm != null) cm.setPrimaryClip(ClipData.newPlainText("ST Reborn", text));
+        });
+    }
+
+    @JavascriptInterface
+    public String clipboardGet() {
+        ClipboardManager cm = (ClipboardManager) activity.getSystemService(Context.CLIPBOARD_SERVICE);
+        if (cm == null || !cm.hasPrimaryClip() || cm.getPrimaryClip().getItemCount() == 0) return "";
+        CharSequence t = cm.getPrimaryClip().getItemAt(0).coerceToText(activity);
+        return t == null ? "" : t.toString();
+    }
+
+    @JavascriptInterface
+    public void quit() {
+        ui.post(() -> activity.moveTaskToBack(true));
+    }
+
+    // ---- event pump ----------------------------------------------------------------
+
+    void startPump() {
+        if (pumping) return;
+        pumping = true;
+        Thread t = new Thread(() -> {
+            while (pumping) {
+                String ev;
+                try {
+                    ev = GoBridge.str(GoBridge.nextEvent(1000));
+                } catch (Throwable th) {
+                    Log.e(TAG, "event pump", th);
+                    return;
+                }
+                if (ev == null) continue;
+                try {
+                    JSONObject o = new JSONObject(ev);
+                    if ("host".equals(o.optString("kind"))) {
+                        handleHost(o);
+                    } else {
+                        js("window.__strEvent(" + ev + ")");
+                    }
+                } catch (JSONException e) {
+                    Log.w(TAG, "bad event from core: " + e);
+                }
+            }
+        }, "str-events");
+        t.setDaemon(true);
+        t.start();
+    }
+
+    void stopPump() {
+        pumping = false;
+    }
+
+    private void handleHost(JSONObject o) {
+        final long id = o.optLong("id");
+        final String op = o.optString("op");
+        final JSONObject args = o.optJSONObject("args") != null ? o.optJSONObject("args") : new JSONObject();
+        ui.post(() -> {
+            switch (op) {
+                case "openURL":
+                    openExternal(args.optString("url"));
+                    break;
+                case "clipboardSet":
+                    clipboardSet(args.optString("text"));
+                    break;
+                case "clipboardGet":
+                    reply(id, obj("text", clipboardGet()));
+                    break;
+                case "messageDialog":
+                    showMessageDialog(id, args);
+                    break;
+                case "saveFile":
+                    startSave(args);
+                    break;
+                case "openFile":
+                    startOpen(id, args);
+                    break;
+                case "reload":
+                    webView.reload();
+                    break;
+                case "execJS":
+                    webView.evaluateJavascript(args.optString("js"), null);
+                    break;
+                case "quit":
+                    activity.moveTaskToBack(true);
+                    break;
+                default:
+                    Log.w(TAG, "unknown host op " + op);
+                    if (id != 0) reply(id, new JSONObject());
+            }
+        });
+    }
+
+    // ---- host operations -------------------------------------------------------------
+
+    void openExternal(String url) {
+        if (url == null || url.isEmpty()) return;
+        try {
+            Intent i = new Intent(Intent.ACTION_VIEW, Uri.parse(url));
+            i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+            activity.startActivity(i);
+        } catch (ActivityNotFoundException e) {
+            Toast.makeText(activity, url, Toast.LENGTH_LONG).show();
+        }
+    }
+
+    private void showMessageDialog(long id, JSONObject a) {
+        JSONArray buttons = a.optJSONArray("buttons");
+        String cancel = a.optString("cancelButton", "");
+        AlertDialog.Builder b = new AlertDialog.Builder(activity)
+                .setTitle(a.optString("title"))
+                .setMessage(a.optString("message"))
+                .setOnCancelListener(d -> reply(id, obj("button", cancel)));
+        // AlertDialog has three button slots. Wails dialogs in STR use one or two.
+        if (buttons != null && buttons.length() > 0) {
+            final String b0 = buttons.optString(0);
+            if (buttons.length() == 1) {
+                b.setPositiveButton(b0, (d, w) -> reply(id, obj("button", b0)));
+            } else {
+                final String b1 = buttons.optString(1);
+                // The cancel/default choice goes on the negative (left) slot.
+                String neg = b0, pos = b1;
+                if (b1.equals(cancel)) { neg = b1; pos = b0; }
+                final String fNeg = neg, fPos = pos;
+                b.setNegativeButton(fNeg, (d, w) -> reply(id, obj("button", fNeg)));
+                b.setPositiveButton(fPos, (d, w) -> reply(id, obj("button", fPos)));
+                if (buttons.length() > 2) {
+                    final String b2 = buttons.optString(2);
+                    b.setNeutralButton(b2, (d, w) -> reply(id, obj("button", b2)));
+                }
+            }
+        } else {
+            b.setPositiveButton(android.R.string.ok, (d, w) -> reply(id, obj("button", "OK")));
+        }
+        b.show();
+    }
+
+    private void startSave(JSONObject a) {
+        pendingSave = a;
+        Intent i = new Intent(Intent.ACTION_CREATE_DOCUMENT);
+        i.addCategory(Intent.CATEGORY_OPENABLE);
+        i.setType(a.optString("mime", "application/octet-stream"));
+        i.putExtra(Intent.EXTRA_TITLE, a.optString("name", "export"));
+        try {
+            activity.startActivityForResult(i, REQ_SAVE);
+        } catch (ActivityNotFoundException e) {
+            pendingSave = null;
+            Toast.makeText(activity, R.string.no_file_picker, Toast.LENGTH_LONG).show();
+        }
+    }
+
+    private void startOpen(long id, JSONObject a) {
+        pendingOpenId = id;
+        pendingOpenTarget = a.optString("target");
+        Intent i = new Intent(Intent.ACTION_OPEN_DOCUMENT);
+        i.addCategory(Intent.CATEGORY_OPENABLE);
+        i.setType("*/*");
+        JSONArray m = a.optJSONArray("mimes");
+        if (m != null && m.length() > 0) {
+            String[] mimes = new String[m.length()];
+            for (int k = 0; k < m.length(); k++) mimes[k] = m.optString(k);
+            i.putExtra(Intent.EXTRA_MIME_TYPES, mimes);
+        }
+        try {
+            activity.startActivityForResult(i, REQ_OPEN);
+        } catch (ActivityNotFoundException e) {
+            pendingOpenId = 0;
+            reply(id, obj("error", activity.getString(R.string.no_file_picker)));
+        }
+    }
+
+    /** Called from MainActivity.onActivityResult. */
+    boolean onActivityResult(int requestCode, int resultCode, Intent data) {
+        if (requestCode == REQ_SAVE) {
+            final JSONObject a = pendingSave;
+            pendingSave = null;
+            if (a == null || resultCode != Activity.RESULT_OK || data == null || data.getData() == null) return true;
+            final Uri dest = data.getData();
+            calls.execute(() -> {
+                File src = new File(a.optString("path"));
+                try (InputStream in = new FileInputStream(src);
+                     OutputStream out = activity.getContentResolver().openOutputStream(dest, "wt")) {
+                    copy(in, out);
+                    toast(activity.getString(R.string.saved_as, displayName(dest, a.optString("name"))));
+                } catch (IOException | SecurityException e) {
+                    Log.e(TAG, "save failed", e);
+                    toast(activity.getString(R.string.save_failed, String.valueOf(e.getMessage())));
+                } finally {
+                    //noinspection ResultOfMethodCallIgnored
+                    src.delete();
+                }
+            });
+            return true;
+        }
+        if (requestCode == REQ_OPEN) {
+            final long id = pendingOpenId;
+            final String target = pendingOpenTarget;
+            pendingOpenId = 0;
+            if (id == 0) return true;
+            if (resultCode != Activity.RESULT_OK || data == null || data.getData() == null) {
+                reply(id, obj("path", ""));
+                return true;
+            }
+            final Uri src = data.getData();
+            calls.execute(() -> {
+                String name = sanitize(displayName(src, "import"));
+                File dir = new File(target == null || target.isEmpty()
+                        ? activity.getCacheDir().getPath() : target);
+                //noinspection ResultOfMethodCallIgnored
+                dir.mkdirs();
+                File dst = new File(dir, name);
+                try (InputStream in = activity.getContentResolver().openInputStream(src);
+                     OutputStream out = new FileOutputStream(dst)) {
+                    if (in == null) throw new IOException("the file could not be opened");
+                    copy(in, out);
+                    reply(id, obj("path", dst.getAbsolutePath()));
+                } catch (IOException | SecurityException e) {
+                    reply(id, obj("error", String.valueOf(e.getMessage())));
+                }
+            });
+            return true;
+        }
+        return false;
+    }
+
+    // ---- helpers -------------------------------------------------------------------------
+
+    private void js(String script) {
+        ui.post(() -> webView.evaluateJavascript(script, null));
+    }
+
+    private void toast(String msg) {
+        ui.post(() -> Toast.makeText(activity, msg, Toast.LENGTH_LONG).show());
+    }
+
+    private static void reply(long id, JSONObject payload) {
+        if (id == 0) return;
+        GoBridge.hostReply(id, GoBridge.utf8(payload.toString()));
+    }
+
+    private static JSONObject obj(String k, String v) {
+        JSONObject o = new JSONObject();
+        try {
+            o.put(k, v == null ? "" : v);
+        } catch (JSONException ignored) {
+            // put with a non-null String key cannot fail
+        }
+        return o;
+    }
+
+    private static String errorEnvelope(String msg) {
+        JSONObject o = new JSONObject();
+        try {
+            o.put("ok", false);
+            o.put("error", msg);
+        } catch (JSONException ignored) {
+            // cannot fail
+        }
+        return o.toString();
+    }
+
+    private String displayName(Uri uri, String fallback) {
+        try (Cursor c = activity.getContentResolver().query(uri,
+                new String[] {OpenableColumns.DISPLAY_NAME}, null, null, null)) {
+            if (c != null && c.moveToFirst()) {
+                String n = c.getString(0);
+                if (n != null && !n.isEmpty()) return n;
+            }
+        } catch (RuntimeException ignored) {
+            // some providers do not answer the query; the fallback is fine
+        }
+        return fallback;
+    }
+
+    private static String sanitize(String name) {
+        String n = name.replaceAll("[/\\\\:*?\"<>|\\x00]", "_");
+        return n.isEmpty() ? "import" : n;
+    }
+
+    private static void copy(InputStream in, OutputStream out) throws IOException {
+        if (out == null) throw new IOException("the destination could not be opened");
+        byte[] buf = new byte[64 * 1024];
+        int n;
+        while ((n = in.read(buf)) > 0) out.write(buf, 0, n);
+        out.flush();
+    }
+}
diff --git a/android/app/src/main/java/de/streborn/android/MainActivity.java b/android/app/src/main/java/de/streborn/android/MainActivity.java
new file mode 100644
index 00000000..e2b002f6
--- /dev/null
+++ b/android/app/src/main/java/de/streborn/android/MainActivity.java
@@ -0,0 +1,400 @@
+package de.streborn.android;
+
+import android.annotation.SuppressLint;
+import android.app.Activity;
+import android.content.Context;
+import android.content.Intent;
+import android.graphics.Color;
+import android.net.ConnectivityManager;
+import android.net.LinkProperties;
+import android.net.Network;
+import android.net.NetworkCapabilities;
+import android.net.NetworkRequest;
+import android.net.Uri;
+import android.net.wifi.WifiManager;
+import android.os.Build;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.system.ErrnoException;
+import android.system.Os;
+import android.util.Log;
+import android.view.View;
+import android.view.WindowInsets;
+import android.view.WindowManager;
+import android.webkit.WebChromeClient;
+import android.webkit.WebResourceRequest;
+import android.webkit.WebResourceResponse;
+import android.webkit.WebSettings;
+import android.webkit.WebView;
+import android.webkit.WebViewClient;
+import android.widget.FrameLayout;
+
+import androidx.annotation.NonNull;
+import androidx.webkit.WebViewAssetLoader;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.File;
+import java.net.InetAddress;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.StandardCopyOption;
+
+/**
+ * Hosts the STR desktop app's unchanged frontend in a WebView, backed by its
+ * unchanged Go core running in-process (libstr.so).
+ */
+public class MainActivity extends Activity {
+    private static final String TAG = "STR";
+
+    /**
+     * The page is served from https://wails.localhost/, the origin Wails itself
+     * uses on Windows. Every STR speaker agent already allows exactly that
+     * origin to read its answers (internal/webui/server.go, allowedCORSOrigins),
+     * so the frontend's direct speaker requests work against agents already in
+     * the field, and HTTPS keeps the page a secure context.
+     */
+    static final String ORIGIN_HOST = "wails.localhost";
+    static final String START_URL = "https://" + ORIGIN_HOST + "/index.html";
+
+    private static boolean coreStarted;
+
+    private WebView webView;
+    private HostBridge bridge;
+    private WifiManager.MulticastLock multicastLock;
+    private ConnectivityManager.NetworkCallback netCallback;
+    private ConnectivityManager.NetworkCallback wifiCallback;
+    private Network boundWifi;
+    private final Handler ui = new Handler(Looper.getMainLooper());
+    private final Runnable busyPoll = new Runnable() {
+        @Override
+        public void run() {
+            boolean busy = false;
+            try {
+                busy = coreStarted && GoBridge.busy();
+            } catch (Throwable ignored) {
+                // core not loaded
+            }
+            if (busy) {
+                getWindow().addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
+            } else {
+                getWindow().clearFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
+            }
+            ui.postDelayed(this, 2000);
+        }
+    };
+
+    @SuppressLint("SetJavaScriptEnabled")
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+
+        startCore();
+
+        // mDNS and SSDP discovery need multicast, which Wi-Fi drivers filter
+        // out unless an app holds this lock.
+        WifiManager wm = (WifiManager) getApplicationContext().getSystemService(Context.WIFI_SERVICE);
+        if (wm != null) {
+            multicastLock = wm.createMulticastLock("str-discovery");
+            multicastLock.setReferenceCounted(false);
+            multicastLock.acquire();
+        }
+        watchNetwork();
+
+        FrameLayout root = new FrameLayout(this);
+        root.setBackgroundColor(Color.rgb(27, 38, 54)); // the desktop window's background
+        webView = new WebView(this);
+        webView.setBackgroundColor(Color.rgb(27, 38, 54));
+        root.addView(webView, new FrameLayout.LayoutParams(
+                FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT));
+        setContentView(root);
+        applyInsets(root);
+
+        WebSettings s = webView.getSettings();
+        s.setJavaScriptEnabled(true);
+        s.setDomStorageEnabled(true);
+        s.setDatabaseEnabled(true);
+        s.setAllowFileAccess(false);
+        s.setAllowContentAccess(false);
+        s.setMediaPlaybackRequiresUserGesture(false);
+        s.setSupportMultipleWindows(false);
+        // The page is https; speakers and station logos are plain http on the
+        // LAN and the open web. The desktop webview allows the same (see the
+        // CSP in frontend/index.html: connect-src and img-src include http:).
+        s.setMixedContentMode(WebSettings.MIXED_CONTENT_ALWAYS_ALLOW);
+        s.setUserAgentString(s.getUserAgentString() + " STReborn-Android/" + BuildConfig.VERSION_NAME);
+        WebView.setWebContentsDebuggingEnabled(BuildConfig.DEBUG);
+
+        final WebViewAssetLoader assets = new WebViewAssetLoader.Builder()
+                .setDomain(ORIGIN_HOST)
+                .addPathHandler("/", new WebViewAssetLoader.AssetsPathHandler(this))
+                .build();
+
+        webView.setWebViewClient(new WebViewClient() {
+            @Override
+            public WebResourceResponse shouldInterceptRequest(WebView view, WebResourceRequest req) {
+                Uri u = req.getUrl();
+                if (ORIGIN_HOST.equals(u.getHost())) {
+                    String p = u.getPath();
+                    if (p == null || p.isEmpty() || "/".equals(p)) {
+                        u = u.buildUpon().path("/index.html").build();
+                    }
+                    // The built frontend is copied under assets/web/.
+                    Uri mapped = u.buildUpon().path("/web" + u.getPath()).build();
+                    return assets.shouldInterceptRequest(mapped);
+                }
+                return null;
+            }
+
+            @Override
+            public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest req) {
+                Uri u = req.getUrl();
+                if (ORIGIN_HOST.equals(u.getHost())) return false;
+                // Anything else (help pages, GitHub, donate links, a speaker's
+                // phone page) opens in the browser, as on the desktop.
+                bridge.openExternal(u.toString());
+                return true;
+            }
+        });
+        // Setting a WebChromeClient is what enables window.confirm() and
+        // friends; without one the WebView answers them silently with false.
+        webView.setWebChromeClient(new WebChromeClient());
+
+        bridge = new HostBridge(this, webView);
+        webView.addJavascriptInterface(bridge, "STRHost");
+        bridge.startPump();
+
+        if (savedInstanceState != null) {
+            webView.restoreState(savedInstanceState);
+        } else {
+            webView.loadUrl(START_URL);
+        }
+    }
+
+    /**
+     * Loads libstr.so and starts the Go core, once per process. The environment
+     * must be in place before the library loads: the Go runtime snapshots it
+     * at load time, and the app finds its config, cache and log directories
+     * through HOME and the XDG variables.
+     */
+    private void startCore() {
+        if (coreStarted) return;
+        File files = getFilesDir();
+        File cache = getCacheDir();
+        File resolv = new File(files, "resolv.conf");
+        setenv("HOME", files.getAbsolutePath());
+        setenv("XDG_CONFIG_HOME", new File(files, "config").getAbsolutePath());
+        setenv("XDG_DATA_HOME", new File(files, "data").getAbsolutePath());
+        setenv("XDG_CACHE_HOME", cache.getAbsolutePath());
+        setenv("TMPDIR", new File(cache, "tmp").getAbsolutePath());
+        setenv("STR_RESOLV_CONF", resolv.getAbsolutePath());
+        if (BuildConfig.DEBUG) setenv("STR_DEBUG", "1");
+        writeResolvConf(null);
+
+        System.loadLibrary("str");
+
+        final JSONObject cfg = new JSONObject();
+        try {
+            cfg.put("filesDir", files.getAbsolutePath());
+            cfg.put("cacheDir", cache.getAbsolutePath());
+            cfg.put("sdkInt", Build.VERSION.SDK_INT);
+        } catch (JSONException ignored) {
+            // cannot fail
+        }
+        // startup() runs synchronously and touches the network; keep it off
+        // the UI thread. Calls that arrive before it finishes are fine: the
+        // desktop app is written for Wails, which dispatches them the same way.
+        Thread t = new Thread(() -> GoBridge.start(GoBridge.utf8(cfg.toString())), "str-start");
+        t.start();
+        coreStarted = true;
+    }
+
+    private static void setenv(String k, String v) {
+        try {
+            Os.setenv(k, v, true);
+        } catch (ErrnoException e) {
+            Log.w(TAG, "setenv " + k, e);
+        }
+    }
+
+    /**
+     * Two jobs, both about which network the core talks over.
+     *
+     * <p>Wi-Fi first: the core only ever wants the LAN the speakers are on. When
+     * that Wi-Fi has no internet, which is exactly the case while a new speaker
+     * is set up through its own access point, Android keeps mobile data as the
+     * default network, and an app's sockets follow the default network's routing
+     * table, so packets for the speaker would leave over cellular. Binding the
+     * process to the Wi-Fi network while one is connected makes the phone behave
+     * like the desktop does on the same network.
+     *
+     * <p>DNS: keeps the resolv.conf that Go's pure-Go resolver reads in step with
+     * the network in use (see android/goport/overlay); Android has no
+     * /etc/resolv.conf of its own.
+     */
+    private void watchNetwork() {
+        final ConnectivityManager cm = (ConnectivityManager) getSystemService(Context.CONNECTIVITY_SERVICE);
+        if (cm == null) return;
+        Network active = cm.getActiveNetwork();
+        if (active != null) writeResolvConf(cm.getLinkProperties(active));
+
+        netCallback = new ConnectivityManager.NetworkCallback() {
+            @Override
+            public void onLinkPropertiesChanged(@NonNull Network network, @NonNull LinkProperties lp) {
+                if (boundWifi == null) writeResolvConf(lp);
+            }
+        };
+        cm.registerDefaultNetworkCallback(netCallback);
+
+        NetworkRequest wifi = new NetworkRequest.Builder()
+                .addTransportType(NetworkCapabilities.TRANSPORT_WIFI)
+                .removeCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET)
+                .build();
+        wifiCallback = new ConnectivityManager.NetworkCallback() {
+            @Override
+            public void onAvailable(@NonNull Network network) {
+                boundWifi = network;
+                cm.bindProcessToNetwork(network);
+                LinkProperties lp = cm.getLinkProperties(network);
+                if (lp != null) writeResolvConf(lp);
+                Log.i(TAG, "bound to Wi-Fi network " + network);
+            }
+
+            @Override
+            public void onLinkPropertiesChanged(@NonNull Network network, @NonNull LinkProperties lp) {
+                if (network.equals(boundWifi)) writeResolvConf(lp);
+            }
+
+            @Override
+            public void onLost(@NonNull Network network) {
+                if (!network.equals(boundWifi)) return;
+                boundWifi = null;
+                cm.bindProcessToNetwork(null);
+                Network def = cm.getActiveNetwork();
+                if (def != null) writeResolvConf(cm.getLinkProperties(def));
+                Log.i(TAG, "Wi-Fi lost; following the default network");
+            }
+        };
+        cm.registerNetworkCallback(wifi, wifiCallback);
+    }
+
+    private void writeResolvConf(LinkProperties lp) {
+        StringBuilder sb = new StringBuilder("# written by ST Reborn for its Go DNS resolver\n");
+        boolean any = false;
+        if (lp != null) {
+            if (lp.getDomains() != null && !lp.getDomains().isEmpty()) {
+                sb.append("search ").append(lp.getDomains().replace(',', ' ')).append('\n');
+            }
+            for (InetAddress a : lp.getDnsServers()) {
+                String h = a.getHostAddress();
+                if (h == null) continue;
+                int pct = h.indexOf('%'); // strip IPv6 zone
+                sb.append("nameserver ").append(pct > 0 ? h.substring(0, pct) : h).append('\n');
+                any = true;
+            }
+        }
+        if (!any) {
+            // No network information yet: leave an existing file alone rather
+            // than replace good servers with nothing.
+            if (new File(getFilesDir(), "resolv.conf").exists()) return;
+            sb.append("nameserver 8.8.8.8\nnameserver 1.1.1.1\n");
+        }
+        sb.append("options timeout:2 attempts:2\n");
+        try {
+            File dst = new File(getFilesDir(), "resolv.conf");
+            File tmp = new File(getFilesDir(), "resolv.conf.tmp");
+            Files.write(tmp.toPath(), sb.toString().getBytes(StandardCharsets.UTF_8));
+            Files.move(tmp.toPath(), dst.toPath(), StandardCopyOption.REPLACE_EXISTING,
+                    StandardCopyOption.ATOMIC_MOVE);
+        } catch (Exception e) {
+            Log.w(TAG, "could not write resolv.conf", e);
+        }
+    }
+
+    /** Keeps the page clear of the status and navigation bars (edge-to-edge on Android 15+). */
+    private void applyInsets(View root) {
+        root.setOnApplyWindowInsetsListener((v, insets) -> {
+            int l, t, r, b;
+            if (Build.VERSION.SDK_INT >= 30) {
+                android.graphics.Insets i = insets.getInsets(
+                        WindowInsets.Type.systemBars() | WindowInsets.Type.displayCutout() | WindowInsets.Type.ime());
+                l = i.left; t = i.top; r = i.right; b = i.bottom;
+            } else {
+                l = insets.getSystemWindowInsetLeft();
+                t = insets.getSystemWindowInsetTop();
+                r = insets.getSystemWindowInsetRight();
+                b = insets.getSystemWindowInsetBottom();
+            }
+            v.setPadding(l, t, r, b);
+            return insets;
+        });
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        ui.post(busyPoll);
+    }
+
+    @Override
+    protected void onPause() {
+        ui.removeCallbacks(busyPoll);
+        super.onPause();
+    }
+
+    @Override
+    protected void onSaveInstanceState(@NonNull Bundle out) {
+        super.onSaveInstanceState(out);
+        if (webView != null) webView.saveState(out);
+    }
+
+    @SuppressWarnings("deprecation")
+    @Override
+    public void onBackPressed() {
+        // The frontend is one page with no history to go back through. Leaving
+        // is the desktop's "close window": ask the core first, which refuses
+        // (after asking the user) while a speaker is mid-update. The app is then
+        // only moved to the background, so a running core keeps its state.
+        new Thread(() -> {
+            boolean prevent;
+            try {
+                prevent = GoBridge.beforeClose();
+            } catch (Throwable t) {
+                prevent = false;
+            }
+            if (!prevent) ui.post(() -> moveTaskToBack(true));
+        }, "str-close").start();
+    }
+
+    @SuppressWarnings("deprecation")
+    @Override
+    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
+        if (bridge != null && bridge.onActivityResult(requestCode, resultCode, data)) return;
+        super.onActivityResult(requestCode, resultCode, data);
+    }
+
+    @Override
+    protected void onDestroy() {
+        ui.removeCallbacks(busyPoll);
+        if (bridge != null) bridge.stopPump();
+        ConnectivityManager cm = (ConnectivityManager) getSystemService(Context.CONNECTIVITY_SERVICE);
+        if (cm != null) {
+            for (ConnectivityManager.NetworkCallback cb : new ConnectivityManager.NetworkCallback[] {netCallback, wifiCallback}) {
+                if (cb == null) continue;
+                try {
+                    cm.unregisterNetworkCallback(cb);
+                } catch (IllegalArgumentException ignored) {
+                    // already unregistered
+                }
+            }
+        }
+        if (multicastLock != null && multicastLock.isHeld()) multicastLock.release();
+        if (webView != null) {
+            webView.removeJavascriptInterface("STRHost");
+            webView.destroy();
+        }
+        super.onDestroy();
+    }
+}
diff --git a/android/app/src/main/js/android-shim.js b/android/app/src/main/js/android-shim.js
new file mode 100644
index 00000000..d190b0ed
--- /dev/null
+++ b/android/app/src/main/js/android-shim.js
@@ -0,0 +1,210 @@
+// STR Android shim: stands in for the objects Wails injects into its webview.
+//
+// The frontend talks to Go only through two globals: window.go.main.App.<Method>
+// (generated bindings in frontend/wailsjs/go) and window.runtime.* (the Wails JS
+// runtime in frontend/wailsjs/runtime). This file recreates both on top of the
+// Android host's JavaScript interface (window.STRHost, see HostBridge.java), so
+// the frontend runs unchanged. It is loaded as a classic script ahead of the
+// module entry point, which guarantees it runs first.
+//
+// Contract with the host:
+//   STRHost.call(id, method, argsJSON)  -> later window.__strReply(id, envelope)
+//   STRHost.emit(name, dataJSON)        -> Go-side runtime.EventsOn listeners
+//   STRHost.openURL(url), STRHost.clipboardSet(text), STRHost.clipboardGet()
+//   window.__strEvent({name, data})     <- runtime.EventsEmit from Go
+(function () {
+  'use strict';
+  var host = window.STRHost;
+  if (!host) {
+    // Opened outside the Android app (e.g. in a desktop browser for debugging).
+    console.warn('STR Android shim: no host bridge, bindings will reject');
+  }
+
+  // ---- calls -----------------------------------------------------------------
+  var seq = 0;
+  var pending = new Map();
+
+  function call(method, args) {
+    return new Promise(function (resolve, reject) {
+      if (!host) {
+        reject(new Error('Not running inside the STR Android app'));
+        return;
+      }
+      var id = ++seq;
+      pending.set(id, { resolve: resolve, reject: reject });
+      try {
+        host.call(id, method, JSON.stringify(args));
+      } catch (e) {
+        pending.delete(id);
+        reject(e);
+      }
+    });
+  }
+
+  window.__strReply = function (id, env) {
+    var p = pending.get(id);
+    if (!p) return;
+    pending.delete(id);
+    if (env && env.ok) {
+      p.resolve(env.result === undefined ? null : env.result);
+    } else {
+      // Wails rejects with the error string itself, not an Error object; the
+      // frontend's error handling (friendly messages, String(err)) expects that.
+      p.reject(env && env.error !== undefined ? env.error : 'unknown error');
+    }
+  };
+
+  // window.go.main.App: every property is a binding. A Proxy rather than a list
+  // so methods added upstream work without touching this file.
+  var appProxy = new Proxy({}, {
+    get: function (_t, name) {
+      if (typeof name !== 'string' || name === 'then') return undefined;
+      return function () {
+        return call(name, Array.prototype.slice.call(arguments));
+      };
+    },
+  });
+  window.go = { main: { App: appProxy } };
+
+  // ---- events ----------------------------------------------------------------
+  var listeners = new Map(); // name -> [{cb, left}]
+
+  function on(name, cb, max) {
+    var list = listeners.get(name) || [];
+    var entry = { cb: cb, left: max === undefined ? -1 : max };
+    list.push(entry);
+    listeners.set(name, list);
+    return function () {
+      var l = listeners.get(name);
+      if (!l) return;
+      var i = l.indexOf(entry);
+      if (i >= 0) l.splice(i, 1);
+    };
+  }
+
+  function dispatch(name, data) {
+    var list = listeners.get(name);
+    if (!list || !list.length) return;
+    var snapshot = list.slice();
+    for (var i = 0; i < snapshot.length; i++) {
+      var e = snapshot[i];
+      if (e.left > 0) {
+        e.left--;
+        if (e.left === 0) {
+          var idx = list.indexOf(e);
+          if (idx >= 0) list.splice(idx, 1);
+        }
+      }
+      try {
+        e.cb.apply(null, data || []);
+      } catch (err) {
+        console.error('STR event listener for ' + name + ' failed', err);
+      }
+    }
+  }
+
+  window.__strEvent = function (ev) {
+    if (ev && ev.name) dispatch(ev.name, ev.data);
+  };
+
+  var noop = function () {};
+  var resolved = function (v) {
+    return function () { return Promise.resolve(v); };
+  };
+
+  window.runtime = {
+    EventsOnMultiple: on,
+    EventsOn: function (n, cb) { return on(n, cb, -1); },
+    EventsOnce: function (n, cb) { return on(n, cb, 1); },
+    EventsOff: function () {
+      for (var i = 0; i < arguments.length; i++) listeners.delete(arguments[i]);
+    },
+    EventsOffAll: function () { listeners.clear(); },
+    EventsEmit: function (name) {
+      var data = Array.prototype.slice.call(arguments, 1);
+      dispatch(name, data);
+      if (host) host.emit(name, JSON.stringify(data));
+    },
+
+    BrowserOpenURL: function (url) { if (host) host.openURL(String(url)); },
+    ClipboardSetText: function (text) {
+      if (host) host.clipboardSet(String(text));
+      return Promise.resolve(true);
+    },
+    ClipboardGetText: function () {
+      return Promise.resolve(host ? host.clipboardGet() : '');
+    },
+    Environment: resolved({ buildType: 'production', platform: 'android', arch: '' }),
+
+    LogPrint: function (m) { console.log(m); },
+    LogTrace: function (m) { console.debug(m); },
+    LogDebug: function (m) { console.debug(m); },
+    LogInfo: function (m) { console.info(m); },
+    LogWarning: function (m) { console.warn(m); },
+    LogError: function (m) { console.error(m); },
+    LogFatal: function (m) { console.error(m); },
+
+    Quit: function () { if (host) host.quit(); },
+    Hide: noop,
+    Show: noop,
+    WindowReload: function () { location.reload(); },
+    WindowReloadApp: function () { location.reload(); },
+    WindowSetTitle: noop,
+    WindowFullscreen: noop,
+    WindowUnfullscreen: noop,
+    WindowIsFullscreen: resolved(true),
+    WindowCenter: noop,
+    WindowSetSystemDefaultTheme: noop,
+    WindowSetLightTheme: noop,
+    WindowSetDarkTheme: noop,
+    WindowShow: noop,
+    WindowHide: noop,
+    WindowSetSize: noop,
+    WindowGetSize: resolved({ w: window.innerWidth, h: window.innerHeight }),
+    WindowSetMinSize: noop,
+    WindowSetMaxSize: noop,
+    WindowSetAlwaysOnTop: noop,
+    WindowSetPosition: noop,
+    WindowGetPosition: resolved({ x: 0, y: 0 }),
+    WindowMaximise: noop,
+    WindowToggleMaximise: noop,
+    WindowUnmaximise: noop,
+    WindowIsMaximised: resolved(true),
+    WindowMinimise: noop,
+    WindowUnminimise: noop,
+    WindowIsMinimised: resolved(false),
+    WindowIsNormal: resolved(false),
+    WindowSetBackgroundColour: noop,
+    WindowPrint: noop,
+    ScreenGetAll: resolved([]),
+    OnFileDrop: noop,
+    OnFileDropOff: noop,
+    CanResolveFilePaths: function () { return false; },
+    ResolveFilePaths: noop,
+  };
+
+  // navigator.clipboard.writeText can be refused in an app WebView without a
+  // fresh user gesture; route it through the host, which always succeeds.
+  try {
+    if (host && navigator.clipboard) {
+      navigator.clipboard.writeText = function (text) {
+        host.clipboardSet(String(text));
+        return Promise.resolve();
+      };
+    }
+  } catch (_e) { /* read-only in some WebView versions; keep the original */ }
+
+  // Lets the stylesheet adapt the desktop layout for a phone (android.css).
+  document.documentElement.classList.add('platform-android');
+
+  // The tab strip scrolls sideways on a phone (android.css); bring a tab that
+  // was just chosen fully into view instead of leaving it half off-screen.
+  document.addEventListener('click', function (e) {
+    var t = e.target && e.target.closest ? e.target.closest('.tab-btn') : null;
+    if (t && t.scrollIntoView) {
+      setTimeout(function () {
+        t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
+      }, 0);
+    }
+  }, true);
+})();
diff --git a/android/app/src/main/js/android.css b/android/app/src/main/js/android.css
new file mode 100644
index 00000000..c1d4886b
--- /dev/null
+++ b/android/app/src/main/js/android.css
@@ -0,0 +1,66 @@
+/* Phone layout for the desktop frontend.
+ *
+ * Loaded only in the Android app (and the Android dev harness), after the
+ * frontend's own stylesheet. Every rule is scoped to html.platform-android,
+ * which android-shim.js sets, so nothing here can reach the desktop app. The
+ * frontend is already a single 720px column, so this is a short list of
+ * phone-specific corrections rather than a second layout.
+ */
+
+/* No grey flash on tap, no font inflation, no rubber-band glow at the edges. */
+html.platform-android {
+  -webkit-text-size-adjust: 100%;
+  text-size-adjust: 100%;
+  -webkit-tap-highlight-color: transparent;
+}
+html.platform-android body {
+  overscroll-behavior-y: none;
+}
+
+/* Tabs: eight of them do not fit a phone. Keep them on one line and let the
+ * strip scroll sideways, the way phone apps do. The shim scrolls the active
+ * tab into view when it is selected. */
+html.platform-android .tabs {
+  overflow-x: auto;
+  overflow-y: hidden;
+  scroll-snap-type: x proximity;
+  scrollbar-width: none;
+  -webkit-overflow-scrolling: touch;
+  /* Bleed to the screen edges so the strip reads as scrollable. */
+  margin-left: -14px;
+  margin-right: -14px;
+  padding: 0 14px;
+}
+html.platform-android .tabs::-webkit-scrollbar {
+  display: none;
+}
+html.platform-android .tab-btn {
+  flex: none;
+  white-space: nowrap;
+  scroll-snap-align: start;
+  padding: 12px 14px;
+  min-height: 44px;
+}
+
+/* App updates on Android arrive as a new APK, not through the desktop
+ * self-updater, which has no Android build to fetch. Speaker (agent)
+ * updates are unaffected: those live in their own banner and card. */
+html.platform-android #appUpdateBanner {
+  display: none !important;
+}
+
+/* Comfortable touch targets for the small text buttons. */
+html.platform-android button,
+html.platform-android select {
+  min-height: 40px;
+}
+html.platform-android input[type="range"] {
+  min-height: 32px;
+}
+
+/* Setup: the USB-stick route needs a computer that can see and format a USB
+ * drive, which a phone app cannot. The network install (the default route)
+ * stays; a stick can still be prepared with the desktop app. */
+html.platform-android #setupStickDetails {
+  display: none !important;
+}

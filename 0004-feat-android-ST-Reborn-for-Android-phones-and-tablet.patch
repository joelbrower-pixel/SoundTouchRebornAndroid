+plugins {
+    id 'com.android.application'
+}
+
+// The version comes from the same `git describe` the desktop build stamps into
+// the app and its embedded speaker agent (see Makefile), so the Android app and
+// the agent it installs always agree on what "current" is.
+def strVersion = (project.findProperty('strVersion') ?: 'dev').toString()
+def strVersionCode = (project.findProperty('strVersionCode') ?: '1').toString().toInteger()
+
+android {
+    namespace 'de.streborn.android'
+    compileSdk 36
+
+    defaultConfig {
+        applicationId 'de.streborn.android'
+        minSdk 26
+        targetSdk 35
+        versionCode strVersionCode
+        versionName strVersion.replaceFirst('^v', '')
+    }
+
+    buildFeatures {
+        buildConfig true
+    }
+
+    signingConfigs {
+        // Release signing is supplied from outside the repo (see android/README.md).
+        release {
+            def ks = System.getenv('STR_KEYSTORE')
+            if (ks) {
+                storeFile file(ks)
+                storePassword System.getenv('STR_KEYSTORE_PASSWORD')
+                keyAlias System.getenv('STR_KEY_ALIAS')
+                keyPassword System.getenv('STR_KEY_PASSWORD')
+            }
+        }
+    }
+
+    buildTypes {
+        release {
+            minifyEnabled false
+            if (System.getenv('STR_KEYSTORE')) {
+                signingConfig signingConfigs.release
+            } else {
+                // No release key configured: sign with the debug key so the
+                // APK installs. Fine for testing, not for distribution.
+                signingConfig signingConfigs.debug
+            }
+        }
+    }
+
+    compileOptions {
+        sourceCompatibility JavaVersion.VERSION_17
+        targetCompatibility JavaVersion.VERSION_17
+    }
+
+    packaging {
+        jniLibs {
+            // libstr.so is Go; nothing to gain from extracting it.
+            useLegacyPackaging false
+        }
+    }
+
+    // Filled by android/build.sh: jniLibs/<abi>/libstr.so and assets/web/.
+    sourceSets {
+        main {
+            jniLibs.srcDirs = ['build/generated/str/jniLibs']
+            assets.srcDirs = ['build/generated/str/assets']
+        }
+    }
+}
+
+dependencies {
+    implementation 'androidx.webkit:webkit:1.14.0'
+    implementation 'androidx.annotation:annotation:1.9.1'
+}

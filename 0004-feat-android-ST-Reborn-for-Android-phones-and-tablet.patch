diff --git a/android/build.sh b/android/build.sh
new file mode 100755
index 00000000..1a07b063
--- /dev/null
+++ b/android/build.sh
@@ -0,0 +1,182 @@
+#!/usr/bin/env bash
+# Build the ST Reborn Android app.
+#
+#   android/build.sh            build everything and assemble the APK
+#   SKIP_GRADLE=1 android/build.sh   stop after the native library and assets
+#
+# What it does, in the order the Makefile's wails-build does it:
+#   1. cross-compiles the speaker agent (linux/arm, GOARM=5) with the same
+#      version stamp as the app, so a freshly updated speaker never reads as
+#      out of date (see CLAUDE.md, "Build version stamping");
+#   2. optionally fetches the go-librespot Spotify engine (WITH_ENGINE=1);
+#   3. builds the unchanged desktop frontend and adds the Android shim;
+#   4. builds desktop-app as libstr.so for each Android ABI, against the Wails
+#      stand-in (go.android.mod) with the net-package overlay;
+#   5. runs Gradle.
+#
+# Nothing tracked is modified: the agent and engine reach their go:embed slots
+# through `go build -overlay`, and the frontend is built outside frontend/dist.
+#
+# Requirements: Go (the version in go.mod), Node/npm, the Android NDK
+# (ANDROID_NDK_HOME, or an ndk/ folder under ANDROID_HOME), and for step 5 the
+# Android SDK plus Gradle. Android Studio provides the last three.
+set -euo pipefail
+
+HERE="$(cd "$(dirname "$0")" && pwd)"
+ROOT="$(cd "$HERE/.." && pwd)"
+APPDIR="$ROOT/desktop-app"
+GO="${GO:-go}"
+
+VERSION="${VERSION:-$(git -C "$ROOT" describe --tags --always --dirty 2>/dev/null || echo dev)}"
+BUILD_STAMP="${BUILD_STAMP:-$(date '+%Y-%m-%d-%H%M')}"
+ABIS="${ABIS:-arm64-v8a armeabi-v7a x86_64}"
+MIN_API="${MIN_API:-26}"
+
+# Module files. Overridable so an offline or mirrored environment can point at
+# local copies of the dependencies without editing the committed ones.
+APP_MODFILE="${STR_APP_MODFILE:-$APPDIR/go.android.mod}"
+ROOT_MODFILE="${STR_ROOT_MODFILE:-$ROOT/go.mod}"
+
+WORK="$HERE/app/build/str-work"
+GEN="$HERE/app/build/generated/str"
+mkdir -p "$WORK" "$GEN"
+
+log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
+
+# ---- version code: v0.9.95-7-gabc -> 0*10^6 + 9*10^4 + 95*10^2 + 7 ------------
+version_code() {
+  local v="${1#v}" maj min pat extra
+  IFS=.- read -r maj min pat extra _ <<<"$v" || true
+  [[ "$maj" =~ ^[0-9]+$ ]] || { echo 1; return; }
+  [[ "$min" =~ ^[0-9]+$ ]] || min=0
+  [[ "$pat" =~ ^[0-9]+$ ]] || pat=0
+  [[ "$extra" =~ ^[0-9]+$ ]] || extra=0
+  (( extra > 99 )) && extra=99
+  echo $(( maj * 1000000 + min * 10000 + pat * 100 + extra ))
+}
+VERSION_CODE="$(version_code "$VERSION")"
+log "version $VERSION (code $VERSION_CODE), build $BUILD_STAMP"
+
+# ---- 1. speaker agent -------------------------------------------------------------
+log "building the speaker agent (linux/arm, GOARM=5)"
+( cd "$ROOT" && GOOS=linux GOARCH=arm GOARM=5 CGO_ENABLED=0 \
+    "$GO" build -modfile="$ROOT_MODFILE" -trimpath \
+    -ldflags="-s -w -X main.version=$VERSION -X main.buildStamp=$BUILD_STAMP" \
+    -o "$WORK/streborn-armv7l" ./cmd/agent )
+
+# ---- 2. Spotify engine (optional) ---------------------------------------------------
+ENGINE="$APPDIR/agentbin/go-librespot-armv7l"
+if [[ "${WITH_ENGINE:-0}" == 1 ]]; then
+  log "fetching go-librespot-armv7l from the latest release"
+  if command -v gh >/dev/null 2>&1; then
+    tag="$(gh release view --repo JRpersonal/streborn --json tagName --jq .tagName)"
+    gh release download "$tag" --repo JRpersonal/streborn -p go-librespot-armv7l -D "$WORK" --clobber
+  else
+    curl -fL -o "$WORK/go-librespot-armv7l" \
+      https://github.com/JRpersonal/streborn/releases/latest/download/go-librespot-armv7l
+  fi
+  ENGINE="$WORK/go-librespot-armv7l"
+else
+  echo "    (skipped; WITH_ENGINE=1 embeds it, needed to restore Spotify after an agent update)"
+fi
+
+# ---- 3. frontend ----------------------------------------------------------------------
+log "building the frontend"
+( cd "$APPDIR/frontend"
+  [[ -d node_modules ]] || npm ci --no-audit --no-fund
+  npx vite build --outDir "$WORK/web" --emptyOutDir --logLevel warn )
+rm -rf "$GEN/assets/web"
+mkdir -p "$GEN/assets"
+cp -R "$WORK/web" "$GEN/assets/web"
+cp "$HERE/app/src/main/js/android-shim.js" "$GEN/assets/web/android-shim.js"
+cp "$HERE/app/src/main/js/android.css" "$GEN/assets/web/android.css"
+# The shim must run before the module entry point; a classic <script> in the
+# head does. External files, because the page's CSP forbids inline script.
+python3 - "$GEN/assets/web/index.html" <<'PY'
+import re, sys
+p = sys.argv[1]
+s = open(p, encoding="utf-8").read()
+inject = ('<script src="./android-shim.js"></script>\n'
+          '    <link rel="stylesheet" href="./android.css"/>\n')
+if "android-shim.js" not in s:
+    # Phones need the page laid out at device width, without pinch-zoom
+    # fighting the app's own gestures.
+    s = re.sub(r'<meta content="width=device-width[^"]*" name="viewport"\s*/?>',
+               '<meta content="width=device-width, initial-scale=1.0, viewport-fit=cover" name="viewport"/>', s)
+    s = s.replace("</title>", "</title>\n    " + inject, 1)
+open(p, "w", encoding="utf-8").write(s)
+PY
+
+# ---- 4. native library --------------------------------------------------------------
+GOROOT_SRC="$("$GO" env GOROOT)/src"
+OV="$WORK/overlay"
+mkdir -p "$OV"
+# net: the stock files with two mechanical renames, plus the added fallbacks
+# (android/goport/overlay/interface_android_str.go explains why). Generated
+# from whatever GOROOT is in use, so a Go upgrade needs no edit here.
+sed -e 's/^func interfaceTable(/func interfaceTableNetlink(/' \
+    -e 's/syscall\.NetlinkRIB(/netlinkRIBCompat(/g' \
+    "$GOROOT_SRC/net/interface_linux.go" > "$OV/interface_linux.go"
+sed -e 's#"/etc/resolv.conf"#strResolvConfPath()#g' \
+    "$GOROOT_SRC/net/dnsclient_unix.go" > "$OV/dnsclient_unix.go"
+grep -q interfaceTableNetlink "$OV/interface_linux.go" || { echo "net overlay: interfaceTable not found"; exit 1; }
+grep -q strResolvConfPath "$OV/dnsclient_unix.go" || { echo "net overlay: resolv.conf path not found"; exit 1; }
+
+python3 - "$WORK/overlay.json" <<PY
+import json, sys
+repl = {
+    "$GOROOT_SRC/net/interface_linux.go": "$OV/interface_linux.go",
+    "$GOROOT_SRC/net/dnsclient_unix.go": "$OV/dnsclient_unix.go",
+    "$GOROOT_SRC/net/interface_android_str.go": "$HERE/goport/overlay/interface_android_str.go",
+    "$APPDIR/agentbin/streborn-armv7l": "$WORK/streborn-armv7l",
+    "$APPDIR/agentbin/go-librespot-armv7l": "$ENGINE",
+}
+json.dump({"Replace": repl}, open(sys.argv[1], "w"), indent=1)
+PY
+
+if [[ -z "${ANDROID_NDK_HOME:-}" ]]; then
+  for base in "${ANDROID_HOME:-}" "${ANDROID_SDK_ROOT:-}" "$HOME/Android/Sdk" "$HOME/Library/Android/sdk"; do
+    [[ -n "$base" && -d "$base/ndk" ]] || continue
+    ANDROID_NDK_HOME="$(ls -d "$base"/ndk/* | sort -V | tail -1)"
+    break
+  done
+fi
+[[ -n "${ANDROID_NDK_HOME:-}" && -d "$ANDROID_NDK_HOME" ]] || {
+  echo "Android NDK not found: set ANDROID_NDK_HOME (Android Studio: SDK Manager > SDK Tools > NDK)"; exit 1; }
+case "$(uname -s)" in
+  Linux) HOST_TAG=linux-x86_64 ;;
+  Darwin) HOST_TAG=darwin-x86_64 ;;
+  *) echo "unsupported build host"; exit 1 ;;
+esac
+TC="$ANDROID_NDK_HOME/toolchains/llvm/prebuilt/$HOST_TAG/bin"
+
+for abi in $ABIS; do
+  case "$abi" in
+    arm64-v8a)   goarch=arm64; goarm=;  cc="aarch64-linux-android${MIN_API}-clang" ;;
+    armeabi-v7a) goarch=arm;   goarm=7; cc="armv7a-linux-androideabi${MIN_API}-clang" ;;
+    x86_64)      goarch=amd64; goarm=;  cc="x86_64-linux-android${MIN_API}-clang" ;;
+    x86)         goarch=386;   goarm=;  cc="i686-linux-android${MIN_API}-clang" ;;
+    *) echo "unknown ABI $abi"; exit 1 ;;
+  esac
+  log "building libstr.so for $abi"
+  mkdir -p "$GEN/jniLibs/$abi"
+  ( cd "$APPDIR" && GOOS=android GOARCH="$goarch" GOARM="$goarm" CGO_ENABLED=1 CC="$TC/$cc" \
+      "$GO" build -modfile="$APP_MODFILE" -overlay="$WORK/overlay.json" \
+      -buildmode=c-shared -trimpath \
+      -ldflags="-s -w -X main.appVersion=$VERSION -X main.appBuild=$BUILD_STAMP -extldflags=-Wl,-z,max-page-size=16384" \
+      -o "$GEN/jniLibs/$abi/libstr.so" . )
+  rm -f "$GEN/jniLibs/$abi/libstr.h"
+done
+
+# ---- 5. APK -------------------------------------------------------------------------
+if [[ "${SKIP_GRADLE:-0}" == 1 ]]; then
+  log "native library and assets are in $GEN (SKIP_GRADLE=1)"
+  exit 0
+fi
+GRADLE="${GRADLE:-$(command -v gradle || true)}"
+[[ -n "$GRADLE" ]] || { echo "Gradle not found: open android/ in Android Studio, or set GRADLE"; exit 1; }
+log "assembling the APK"
+( cd "$HERE" && "$GRADLE" --no-daemon -q \
+    -PstrVersion="$VERSION" -PstrVersionCode="$VERSION_CODE" \
+    "${GRADLE_TASK:-assembleRelease}" )
+find "$HERE/app/build/outputs" -name '*.apk' -print
diff --git a/android/goport/overlay/interface_android_str.go b/android/goport/overlay/interface_android_str.go
new file mode 100644
index 00000000..1f100c69
--- /dev/null
+++ b/android/goport/overlay/interface_android_str.go
@@ -0,0 +1,217 @@
+// Copyright 2011 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+//
+// Portions adapted from github.com/wlynxg/anet (BSD-3-Clause,
+// Copyright (c) 2023 wlynxg).
+
+//go:build android
+
+// This file is NOT part of the STR module. It is injected into the standard
+// library's net package with `go build -overlay` for the Android build only
+// (see android/goport/build-go.sh).
+//
+// Why: since Android 11 (API 30) an app's SELinux domain may no longer bind()
+// a NETLINK_ROUTE socket and may not send RTM_GETLINK. syscall.NetlinkRIB
+// does both, so net.Interfaces() and net.InterfaceAddrs() fail with
+// "permission denied" for every app that targets API 30+ (golang/go#40569).
+// STR's speaker discovery (mDNS via zeroconf, SSDP for media servers, the
+// per-subnet probe) is built on those two calls in about ten places, one of
+// them inside a third-party library, so it is fixed once, here, instead of in
+// every caller.
+//
+// The overlay renames the stock interfaceTable to interfaceTableNetlink and
+// routes every syscall.NetlinkRIB call through netlinkRIBCompat. On an older
+// Android, or anywhere the stock path still works, behaviour is unchanged.
+
+package net
+
+import (
+	"bytes"
+	"os"
+	"syscall"
+	"unsafe"
+)
+
+// interfaceTable tries the stock RTM_GETLINK dump first and falls back to
+// deriving the table from RTM_GETADDR plus per-interface ioctls, which the
+// app domain is still allowed to do. The fallback cannot see interfaces that
+// have no address (irrelevant for reaching a speaker) and never reports a
+// hardware address (Android hides MACs from apps anyway).
+func interfaceTable(ifindex int) ([]Interface, error) {
+	ift, err := interfaceTableNetlink(ifindex)
+	if err == nil && len(ift) > 0 {
+		return ift, nil
+	}
+	alt, aerr := interfaceTableFromAddrs(ifindex)
+	if aerr == nil {
+		return alt, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	return ift, nil
+}
+
+func interfaceTableFromAddrs(ifindex int) ([]Interface, error) {
+	tab, err := netlinkRIBCompat(syscall.RTM_GETADDR, syscall.AF_UNSPEC)
+	if err != nil {
+		return nil, os.NewSyscallError("netlinkrib", err)
+	}
+	msgs, err := syscall.ParseNetlinkMessage(tab)
+	if err != nil {
+		return nil, os.NewSyscallError("parsenetlinkmessage", err)
+	}
+	var ift []Interface
+	seen := make(map[uint32]bool)
+loop:
+	for _, m := range msgs {
+		switch m.Header.Type {
+		case syscall.NLMSG_DONE:
+			break loop
+		case syscall.RTM_NEWADDR:
+			ifam := (*syscall.IfAddrmsg)(unsafe.Pointer(&m.Data[0]))
+			if seen[ifam.Index] {
+				continue
+			}
+			seen[ifam.Index] = true
+			if ifindex != 0 && ifindex != int(ifam.Index) {
+				continue
+			}
+			if ifi := strLinkFromIndex(ifam.Index); ifi != nil {
+				ift = append(ift, *ifi)
+			}
+			if ifindex == int(ifam.Index) {
+				break loop
+			}
+		}
+	}
+	return ift, nil
+}
+
+// strIfReq mirrors struct ifreq: a 16-byte name followed by a union that is
+// at most 24 bytes on 64-bit targets.
+type strIfReq [40]byte
+
+func strIoctl(fd int, req uintptr, arg unsafe.Pointer) error {
+	_, _, e := syscall.Syscall(syscall.SYS_IOCTL, uintptr(fd), req, uintptr(arg))
+	if e != 0 {
+		return e
+	}
+	return nil
+}
+
+func strLinkFromIndex(index uint32) *Interface {
+	fd, err := syscall.Socket(syscall.AF_INET, syscall.SOCK_DGRAM|syscall.SOCK_CLOEXEC, 0)
+	if err != nil {
+		return nil
+	}
+	defer syscall.Close(fd)
+
+	var r strIfReq
+	*(*uint32)(unsafe.Pointer(&r[syscall.IFNAMSIZ])) = index
+	if strIoctl(fd, syscall.SIOCGIFNAME, unsafe.Pointer(&r[0])) != nil {
+		return nil
+	}
+	name := string(bytes.TrimRight(r[:syscall.IFNAMSIZ], "\x00"))
+	ifi := &Interface{Index: int(index), Name: name}
+
+	r = strIfReq{}
+	copy(r[:syscall.IFNAMSIZ-1], name)
+	if strIoctl(fd, syscall.SIOCGIFMTU, unsafe.Pointer(&r[0])) == nil {
+		ifi.MTU = int(*(*int32)(unsafe.Pointer(&r[syscall.IFNAMSIZ])))
+	}
+	r = strIfReq{}
+	copy(r[:syscall.IFNAMSIZ-1], name)
+	if strIoctl(fd, syscall.SIOCGIFFLAGS, unsafe.Pointer(&r[0])) == nil {
+		ifi.Flags = linkFlags(uint32(*(*uint16)(unsafe.Pointer(&r[syscall.IFNAMSIZ]))))
+	}
+	return ifi
+}
+
+// netlinkRIBCompat is syscall.NetlinkRIB with a fallback that skips bind().
+// The kernel autobinds a netlink socket on first send, so the explicit bind
+// in the stock implementation is not needed for a dump request.
+func netlinkRIBCompat(proto, family int) ([]byte, error) {
+	tab, err := syscall.NetlinkRIB(proto, family)
+	if err == nil {
+		return tab, nil
+	}
+	if alt, aerr := strNetlinkRIBNoBind(proto, family); aerr == nil {
+		return alt, nil
+	}
+	return nil, err
+}
+
+func strNetlinkRIBNoBind(proto, family int) ([]byte, error) {
+	s, err := syscall.Socket(syscall.AF_NETLINK, syscall.SOCK_RAW|syscall.SOCK_CLOEXEC, syscall.NETLINK_ROUTE)
+	if err != nil {
+		return nil, err
+	}
+	defer syscall.Close(s)
+
+	req := make([]byte, syscall.NLMSG_HDRLEN+syscall.SizeofRtGenmsg)
+	*(*uint32)(unsafe.Pointer(&req[0])) = uint32(len(req))
+	*(*uint16)(unsafe.Pointer(&req[4])) = uint16(proto)
+	*(*uint16)(unsafe.Pointer(&req[6])) = uint16(syscall.NLM_F_DUMP | syscall.NLM_F_REQUEST)
+	*(*uint32)(unsafe.Pointer(&req[8])) = 1 // seq
+	req[16] = byte(family)
+
+	sa := &syscall.SockaddrNetlink{Family: syscall.AF_NETLINK}
+	if err := syscall.Sendto(s, req, 0, sa); err != nil {
+		return nil, err
+	}
+	lsa, err := syscall.Getsockname(s)
+	if err != nil {
+		return nil, err
+	}
+	lnl, ok := lsa.(*syscall.SockaddrNetlink)
+	if !ok {
+		return nil, syscall.EINVAL
+	}
+	var tab []byte
+	buf := make([]byte, syscall.Getpagesize())
+	for {
+		n, _, err := syscall.Recvfrom(s, buf, 0)
+		if err != nil {
+			return nil, err
+		}
+		if n < syscall.NLMSG_HDRLEN {
+			return nil, syscall.EINVAL
+		}
+		chunk := buf[:n]
+		tab = append(tab, chunk...)
+		msgs, err := syscall.ParseNetlinkMessage(chunk)
+		if err != nil {
+			return nil, err
+		}
+		for _, m := range msgs {
+			if m.Header.Seq != 1 || m.Header.Pid != lnl.Pid {
+				return nil, syscall.EINVAL
+			}
+			if m.Header.Type == syscall.NLMSG_DONE {
+				return tab, nil
+			}
+			if m.Header.Type == syscall.NLMSG_ERROR {
+				return nil, syscall.EINVAL
+			}
+		}
+	}
+}
+
+// strResolvConfPath points the pure-Go DNS resolver at the resolv.conf the
+// Android host writes (android/app: DnsConfigWriter), because Android has no
+// /etc/resolv.conf and the stock fallback, 127.0.0.1:53, answers nothing
+// (golang/go#8877). Lookups through net.DefaultResolver already go to the
+// platform resolver via cgo on Android; this matters for resolvers pinned
+// with PreferGo, which STR's update client deliberately uses. The overlay
+// substitutes this call for the literal path in dnsclient_unix.go, and the
+// stock 5-second mtime check picks up rewrites after a network change.
+func strResolvConfPath() string {
+	if p := os.Getenv("STR_RESOLV_CONF"); p != "" {
+		if _, err := os.Stat(p); err == nil {
+			return p
+		}
+	}
+	return "/etc/resolv.conf"
+}
